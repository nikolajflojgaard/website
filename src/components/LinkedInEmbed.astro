---
// LinkedIn Embed Component
// Usage: {% linkedin https://www.linkedin.com/posts/USERNAME_post-id %}
---

<div class="linkedin-embed-container">
  <iframe 
    src="" 
    class="linkedin-embed-iframe"
    frameborder="0" 
    allowfullscreen="" 
    title="LinkedIn post"
    loading="lazy"
  ></iframe>
</div>

<style>
  .linkedin-embed-container {
    margin: 2rem 0;
    position: relative;
    width: 100%;
  }
  
  .linkedin-embed-iframe {
    width: 100%;
    min-height: 400px;
    border: none;
    border-radius: 8px;
  }
</style>
