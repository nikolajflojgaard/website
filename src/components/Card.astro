---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import { getPath } from "@/utils/getPath";
import { calculateReadingTime } from "@/utils/readingTime";
import { slugifyStr } from "@/utils/slugify";
import Datetime from "./Datetime.astro";

export interface Props extends CollectionEntry<"blog"> {
  variant?: "h2" | "h3";
  showImage?: boolean;
}

const { variant = "h2", data, id, filePath, body, showImage = true } = Astro.props;

const { title, description, pubDatetime, modDatetime, timezone, heroImage, ogImage, source } = data;
const readingTime = calculateReadingTime(body ?? "");
const cardImage = heroImage || ogImage;

const headerProps = {
  style: { viewTransitionName: slugifyStr(title) },
  class: "text-lg font-medium decoration-dashed hover:underline",
};
---

<li class="my-6">
  <article class="rounded-2xl border border-border bg-background/60 p-5 transition-all hover:border-accent/30 hover:bg-muted/15 hover:shadow-sm">
    <a
      href={getPath(id, filePath)}
      class="inline-block text-lg font-medium text-accent decoration-dashed underline-offset-4 focus-visible:no-underline focus-visible:underline-offset-0"
    >
      {
        variant === "h2" ? (
          <h2 {...headerProps}>{title}</h2>
        ) : (
          <h3 {...headerProps}>{title}</h3>
        )
      }
    </a>
    <div class="flex items-center gap-3 mb-4 flex-wrap text-sm">
      <Datetime {pubDatetime} {modDatetime} {timezone} />
      <span class="text-sm italic opacity-80">• {readingTime}</span>
      {source === "LinkedIn" && (
        <span class="inline-flex items-center gap-1 px-2 py-0.5 text-xs font-medium bg-[#0A66C2]/10 text-[#0A66C2] rounded-full">
          <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 24 24">
            <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
          </svg>
          LinkedIn
        </span>
      )}
    </div>
    <div class="flex items-start gap-4 md:gap-5">
      {showImage && cardImage && (
        <a 
          href={getPath(id, filePath)}
          class="flex-shrink-0 hidden sm:block group"
        >
          {typeof cardImage === "string" ? (
            <img
              src={cardImage}
              alt={title}
              width="140"
              height="79"
              class="h-[84px] w-[148px] rounded-lg border border-border/60 object-cover shadow-sm transition-all duration-200 group-hover:scale-[1.03] group-hover:shadow-md"
              loading="lazy"
              decoding="async"
            />
          ) : (
            <Image
              src={cardImage}
              alt={title}
              width={140}
              height={79}
              class="rounded-lg border border-border/60 object-cover shadow-sm transition-all duration-200 group-hover:scale-[1.03] group-hover:shadow-md"
              format="webp"
              quality={80}
              loading="lazy"
              densities={[1, 2]}
            />
          )}
        </a>
      )}
      <p class="flex-1 leading-7 text-foreground/78">{description}</p>
    </div>
  </article>
</li>
