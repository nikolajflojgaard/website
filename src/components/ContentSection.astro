---
interface Props {
  title: string;
  description?: string;
  className?: string;
  contentClassName?: string;
}

const { title, description, className = "", contentClassName = "" } = Astro.props;
---

<section class={`mb-12 ${className}`.trim()}>
  <div class={`mb-6 ${contentClassName}`.trim()}>
    <h2 class="text-2xl font-semibold">{title}</h2>
    {description && <p class="mt-2 text-sm leading-7 text-foreground/65">{description}</p>}
  </div>
  <slot />
</section>
