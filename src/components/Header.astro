---
import IconArchive from "@/assets/icons/IconArchive.svg";
import IconMenuDeep from "@/assets/icons/IconMenuDeep.svg";
import IconMoon from "@/assets/icons/IconMoon.svg";
import IconSearch from "@/assets/icons/IconSearch.svg";
import IconSunHigh from "@/assets/icons/IconSunHigh.svg";
import IconUserCircle from "@/assets/icons/IconUserCircle.svg";
import IconX from "@/assets/icons/IconX.svg";
import { SITE } from "@/config";
import Hr from "./Hr.astro";
import LinkButton from "./LinkButton.astro";

const { pathname } = Astro.url;

// Remove trailing slash from current pathname if exists
const currentPath = pathname.endsWith("/") && pathname !== "/" ? pathname.slice(0, -1) : pathname;

const isActive = (path: string) => {
  const currentPathArray = currentPath.split("/").filter((p) => p.trim());
  const pathArray = path.split("/").filter((p) => p.trim());

  return currentPath === path || currentPathArray[0] === pathArray[0];
};
---

<header>
  <a
    id="skip-to-content"
    href="#main-content"
    class="absolute -top-full left-16 z-50 bg-background px-3 py-2 text-accent backdrop-blur-lg transition-all focus:top-4"
  >
    Skip to content
  </a>
  <div
    id="nav-container"
    class="site-shell flex flex-col items-center justify-between sm:flex-row"
  >
    <div
      id="top-nav-wrap"
      class="relative flex w-full items-baseline justify-between bg-background p-4 sm:items-center sm:py-6"
    >
      <a
        href="/"
        class="absolute py-1 text-2xl leading-7 font-semibold whitespace-nowrap sm:static"
      >
        {SITE.title}
      </a>
      <nav
        id="nav-menu"
        class="flex w-full flex-col items-center sm:ml-2 sm:flex-row sm:justify-end sm:space-x-4 sm:py-0"
      >
        <button
          id="menu-btn"
          class="focus-outline self-end p-2 sm:hidden"
          aria-label="Open Menu"
          aria-expanded="false"
          aria-controls="menu-items"
        >
          <IconX id="close-icon" class="hidden" />
          <IconMenuDeep id="menu-icon" />
        </button>
        <ul
          id="menu-items"
          class:list={[
            "mt-4 grid w-44 grid-cols-2 place-content-center gap-2",
            "[&>li>a]:block [&>li>a]:px-4 [&>li>a]:py-3 [&>li>a]:text-center [&>li>a]:font-medium [&>li>a]:hover:text-accent sm:[&>li>a]:px-2 sm:[&>li>a]:py-1",
            "hidden",
            "sm:mt-0 sm:ml-0 sm:flex sm:w-auto sm:gap-x-5 sm:gap-y-0",
          ]}
        >
          <li class="col-span-2">
            <a href="/posts" class:list={{ "active-nav": isActive("/posts") }}>
              Posts
            </a>
          </li>
          <!-- <li class="col-span-2">
            <a href="/tags" class:list={{ "active-nav": isActive("/tags") }}>
              Tags
            </a>
          </li> -->
          <li class="col-span-2">
            <a href="/about" class:list={{ "active-nav": isActive("/about") }}>
              About
            </a>
          </li>
          <li class="col-span-2">
            <a href="/projects" class:list={{ "active-nav": isActive("/projects") }}>
              Projects
            </a>
          </li>
          <li class="col-span-2">
            <a href="/resume" class:list={{ "active-nav": isActive("/resume") }}>
              Work
            </a>
          </li>
          {
            SITE.showArchives && (
              <li class="col-span-2">
                <LinkButton
                  href="/archives"
                  class:list={[
                    "focus-outline flex justify-center p-3 sm:p-1",
                    {
                      "active-nav [&>svg]:stroke-accent": isActive("/archives"),
                    },
                  ]}
                  ariaLabel="archives"
                  title="Archives"
                >
                  <IconArchive class="hidden sm:inline-block" />
                  <span class="sm:sr-only">Archives</span>
                </LinkButton>
              </li>
            )
          }
          <li class="col-span-1 flex items-center justify-center">
            <LinkButton
              href="/search"
              class:list={[
                "focus-outline flex p-3 sm:p-1",
                { "[&>svg]:stroke-accent": isActive("/search") },
              ]}
              ariaLabel="search"
              title="Search"
            >
              <IconSearch />
              <span class="sr-only">Search</span>
            </LinkButton>
          </li>
          {
            SITE.lightAndDarkMode && (
              <li class="col-span-1 flex items-center justify-center">
                <button
                  id="theme-btn"
                  class="focus-outline relative size-12 p-4 sm:size-8 hover:[&>svg]:stroke-accent"
                  title="Toggles light & dark"
                  aria-label="auto"
                  aria-live="polite"
                >
                  <IconMoon class="absolute top-[50%] left-[50%] -translate-[50%] scale-100 rotate-0 transition-all dark:scale-0 dark:-rotate-90" />
                  <IconSunHigh class="absolute top-[50%] left-[50%] -translate-[50%] scale-0 rotate-90 transition-all dark:scale-100 dark:rotate-0" />
                </button>
              </li>
            )
          }
          <li class="col-span-1 flex items-center justify-center">
            <button
              id="agent-auth-btn"
              class="focus-outline relative size-12 p-4 sm:size-8 hover:[&>svg]:stroke-accent"
              title="Sign in"
              aria-label="Sign in"
              data-auth-state="signed-out"
            >
              <IconUserCircle class="absolute top-[50%] left-[50%] -translate-[50%]" />
              <span id="agent-auth-label" class="sr-only">Sign in</span>
            </button>
          </li>
        </ul>
      </nav>
    </div>
  </div>
  <Hr />
</header>

<script>
  // @ts-nocheck
  import { createClient } from "@supabase/supabase-js";

  function toggleNav() {
    const menuBtn = document.querySelector("#menu-btn");
    const menuItems = document.querySelector("#menu-items");
    const menuIcon = document.querySelector("#menu-icon");
    const closeIcon = document.querySelector("#close-icon");

    if (!menuBtn || !menuItems || !menuIcon || !closeIcon) return;

    menuBtn.addEventListener("click", () => {
      const openMenu = menuBtn.getAttribute("aria-expanded") === "true";

      menuBtn.setAttribute("aria-expanded", openMenu ? "false" : "true");
      menuBtn.setAttribute("aria-label", openMenu ? "Open Menu" : "Close Menu");

      menuItems.classList.toggle("hidden");
      menuIcon.classList.toggle("hidden");
      closeIcon.classList.toggle("hidden");
    });
  }

  toggleNav();

  function setupAgentAuth() {
    const button = document.querySelector("#agent-auth-btn");
    const label = document.querySelector("#agent-auth-label");
    if (!(button instanceof HTMLButtonElement) || button.dataset.authBound === "true") return;

    button.dataset.authBound = "true";

    const supabaseUrl = import.meta.env.PUBLIC_SUPABASE_URL ?? "";
    const supabaseAnonKey = import.meta.env.PUBLIC_SUPABASE_ANON_KEY ?? "";
    const allowedEmail = (import.meta.env.PUBLIC_AGENT_OS_ALLOWED_EMAIL ?? "").trim().toLowerCase();

    const setButtonState = (state, text) => {
      button.dataset.authState = state;
      button.title = text;
      button.setAttribute("aria-label", text);
      if (label) label.textContent = text;
    };

    if (!supabaseUrl || !supabaseAnonKey) {
      button.disabled = true;
      setButtonState("unavailable", "Login unavailable");
      return;
    }

    const supabase = createClient(supabaseUrl, supabaseAnonKey, {
      auth: {
        autoRefreshToken: true,
        persistSession: true,
        detectSessionInUrl: true,
      },
    });

    const cleanAuthUrl = () => {
      const url = new URL(window.location.href);
      url.searchParams.delete("code");
      url.searchParams.delete("error");
      url.searchParams.delete("error_code");
      url.searchParams.delete("error_description");
      window.history.replaceState({}, document.title, `${url.pathname}${url.search}${url.hash}`);
    };

    const isAllowedUser = (user) => {
      const isLocalDev = ["localhost", "127.0.0.1"].includes(window.location.hostname);
      if (!allowedEmail) return isLocalDev;
      const email = user?.email?.trim().toLowerCase();
      return Boolean(email) && email === allowedEmail;
    };

    const renderSession = async (session) => {
      const user = session?.user;

      if (user && !isAllowedUser(user)) {
        await supabase.auth.signOut();
        setButtonState("signed-out", "Sign in");
        return;
      }

      if (user) {
        setButtonState("signed-in", "Sign out");
        return;
      }

      setButtonState("signed-out", "Sign in");
    };

    const finishAuthRedirect = async () => {
      const url = new URL(window.location.href);
      const code = url.searchParams.get("code");
      const authError = url.searchParams.get("error") || url.searchParams.get("error_description");

      if (authError) {
        cleanAuthUrl();
        return;
      }

      if (!code) return;

      await supabase.auth.exchangeCodeForSession(code);
      cleanAuthUrl();
    };

    button.addEventListener("click", async () => {
      const { data } = await supabase.auth.getSession();
      const user = data.session?.user;

      if (user && isAllowedUser(user)) {
        await supabase.auth.signOut();
        return;
      }

      const redirectTo = new URL(`${window.location.pathname}${window.location.hash}`, window.location.origin).toString();
      await supabase.auth.signInWithOAuth({
        provider: "google",
        options: { redirectTo },
      });
    });

    supabase.auth.onAuthStateChange((_, session) => {
      void renderSession(session);
    });

    void finishAuthRedirect().then(async () => {
      const { data } = await supabase.auth.getSession();
      await renderSession(data.session);
    });
  }

  setupAgentAuth();

  // Runs on view transitions navigation
  document.addEventListener("astro:after-swap", () => {
    toggleNav();
    setupAgentAuth();
  });
</script>

<style>
  #agent-auth-btn[data-auth-state="signed-in"] svg {
    stroke: var(--accent);
  }

  #agent-auth-btn[data-auth-state="unavailable"] {
    cursor: not-allowed;
    opacity: 0.45;
  }
</style>
