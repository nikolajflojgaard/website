---
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import Footer from "@/components/Footer.astro";
import Header from "@/components/Header.astro";
import Hr from "@/components/Hr.astro";
import LinkButton from "@/components/LinkButton.astro";
import Socials from "@/components/Socials.astro";
import StructuredData from "@/components/StructuredData.astro";
import { SITE, SOCIALS } from "@/config";
import Layout from "@/layouts/Layout.astro";
import { getCollection } from "astro:content";
import type { CollectionEntry } from "astro:content";

// Get actual blog posts
const allPosts = await getCollection("blog", ({ data }) => !data.draft);
const sortedPosts = allPosts.sort((a, b) => {
  const aDate = a.data.pubDatetime || new Date();
  const bDate = b.data.pubDatetime || new Date();
  return new Date(bDate).getTime() - new Date(aDate).getTime();
});

// Generate correct slug matching the routing logic in [...slug].astro
const generateSlug = (post: CollectionEntry<"blog">) => {
  const postId = post.id;
  
  // Check if post is already in a year directory (e.g., 2026/filename)
  const yearDirMatch = postId.match(/^(\d{4})\/(.*)/);
  if (yearDirMatch) {
    return postId; // Already has year prefix
  }
  
  // For posts not in year directories, extract year from metadata or filename
  const pubDate = post.data.pubDatetime;
  const year = pubDate
    ? pubDate.getFullYear().toString()
    : postId.match(/^(\d{4})-\d{2}-\d{2}/)
      ? postId.substring(0, 4)
      : new Date().getFullYear().toString();
  
  return `${year}/${postId}`;
};

const featuredPosts = sortedPosts.slice(0, 3).map(post => ({
  title: post.data.title,
  description: post.data.description || "",
  date: new Date(post.data.pubDatetime).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }),
  slug: generateSlug(post)
}));
---

<Layout description={SITE.desc}>
  <StructuredData type="WebSite" data={{}} />
  <StructuredData type="Person" data={{}} />
  <Header />
  <main id="main-content" data-layout="index">
    
    {/* Hero */}
    <section id="hero" class="pt-6 pb-8">
      <div class="flex flex-col sm:flex-row items-start gap-4">
        <a href="/about" class="block mx-auto sm:mx-0 group">
          <img 
            src="/hero.png" 
            alt={SITE.title}
            class="w-32 h-32 rounded-full object-cover flex-shrink-0 transition-all duration-300 group-hover:scale-105 group-hover:shadow-xl"
          />
        </a>
        <div class="flex-1 text-center sm:text-left">
          <h1 class="my-2 inline-block text-2xl font-bold sm:my-3 sm:text-3xl">
            Hi, I'm {SITE.title}.
          </h1>
          <p class="text-skin-base/80 max-w-2xl">
            {SITE.desc}
          </p>
          <p class="mt-3 text-sm text-skin-base/65 max-w-2xl">
            Less hype, more systems thinking: practical notes on enterprise integration, agentic workflows, and autonomy from the edge of real-world implementation.
          </p>
          {
            SOCIALS.filter((social) => social.active).length > 0 && (
              <div class="mt-3 flex flex-row items-center justify-center sm:justify-start">
                <Socials />
              </div>
            )
          }
        </div>
      </div>
    </section>

    <Hr />

    {/* Proof / Focus Section */}
    <section class="py-12">
      <div class="flex items-center justify-between mb-6">
        <h2 class="text-xl font-semibold">What I actually spend time on</h2>
        <LinkButton href="/about">
          More about me
          <IconArrowRight class="inline-block" />
        </LinkButton>
      </div>

      <div class="grid md:grid-cols-3 gap-4">
        <div class="p-5 bg-skin-fill/30 border border-skin-line rounded-xl">
          <h3 class="font-semibold mb-2">Enterprise architecture</h3>
          <p class="text-sm text-skin-base/70">Integration strategy, system design, and the uncomfortable tradeoffs that show up in real delivery, not just diagrams.</p>
        </div>
        <div class="p-5 bg-skin-fill/30 border border-skin-line rounded-xl">
          <h3 class="font-semibold mb-2">Agentic workflows</h3>
          <p class="text-sm text-skin-base/70">What happens when AI leaves the demo stage and has to deal with brittle tools, bad context, and actual operational constraints.</p>
        </div>
        <div class="p-5 bg-skin-fill/30 border border-skin-line rounded-xl">
          <h3 class="font-semibold mb-2">Built things, not just opinions</h3>
          <p class="text-sm text-skin-base/70">Home Assistant tooling, workflow automation, architecture notes, and practical product experiments that are meant to survive production.</p>
        </div>
      </div>
    </section>

    <Hr />

    <section class="py-12">
      <div class="rounded-2xl border border-accent/20 bg-gradient-to-br from-accent/10 to-accent/5 p-6 sm:p-8">
        <div class="flex items-center justify-between mb-6 gap-4 flex-col sm:flex-row sm:items-end">
          <div>
            <h2 class="text-xl font-semibold">Start here</h2>
            <p class="mt-2 max-w-2xl text-sm text-skin-base/70">If you are new here, these are the three lanes that best explain what I write about and where I tend to have a point of view.</p>
          </div>
          <LinkButton href="/posts/">
            Browse everything
            <IconArrowRight class="inline-block" />
          </LinkButton>
        </div>

        <div class="grid md:grid-cols-3 gap-4">
          <a href="/tags/ai" class="block p-5 bg-background/65 border border-accent/15 rounded-xl hover:border-accent/40 hover:bg-background/80 transition-all backdrop-blur-sm">
            <div class="text-2xl mb-3">🤖</div>
            <h3 class="font-semibold mb-2">AI systems</h3>
            <p class="text-sm text-skin-base/70">Agents, evals, workflow design, and what breaks when AI hits production reality.</p>
          </a>
          <a href="/tags/autonomy" class="block p-5 bg-background/65 border border-accent/15 rounded-xl hover:border-accent/40 hover:bg-background/80 transition-all backdrop-blur-sm">
            <div class="text-2xl mb-3">🚗</div>
            <h3 class="font-semibold mb-2">Autonomy</h3>
            <p class="text-sm text-skin-base/70">Signals, constraints, and where real progress is happening beyond the marketing layer.</p>
          </a>
          <a href="/tags/integration-architecture" class="block p-5 bg-background/65 border border-accent/15 rounded-xl hover:border-accent/40 hover:bg-background/80 transition-all backdrop-blur-sm">
            <div class="text-2xl mb-3">⚡</div>
            <h3 class="font-semibold mb-2">Systems & integration</h3>
            <p class="text-sm text-skin-base/70">Architecture patterns, platform tradeoffs, and the complexity that actually matters.</p>
          </a>
        </div>
      </div>
    </section>

    <Hr />

    <!-- Featured Content Teaser -->
    <section class="py-12">
      <div class="flex items-center justify-between mb-6">
        <h2 class="text-xl font-semibold">From the blog</h2>
        <LinkButton href="/posts/">
          All Posts
          <IconArrowRight class="inline-block" />
        </LinkButton>
      </div>
      
      {featuredPosts.length > 0 ? (
        <div class="grid md:grid-cols-3 gap-4">
          {featuredPosts.map((post) => (
            <a href={`/posts/${post.slug}`} class="block p-4 bg-skin-fill/30 border border-skin-line rounded-lg hover:border-accent/50 hover:bg-skin-fill/50 transition-all group">
              <div class="text-skin-base/50 text-xs mb-2">{post.date}</div>
              <h3 class="font-medium mb-2 line-clamp-2 group-hover:text-accent transition-colors">{post.title}</h3>
              <p class="text-sm text-skin-base/70 line-clamp-2">{post.description}</p>
            </a>
          ))}
        </div>
      ) : (
        <div class="p-6 bg-skin-fill/30 border border-skin-line rounded-lg text-center">
          <p class="text-skin-base/70">No posts yet — check back soon!</p>
        </div>
      )}
    </section>

  </main>
  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset?.layout;
    if (indexLayout) {
      sessionStorage.setItem("backUrl", "/");
    }
  });
</script>
