---
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import Footer from "@/components/Footer.astro";
import Header from "@/components/Header.astro";
import Hr from "@/components/Hr.astro";
import LinkButton from "@/components/LinkButton.astro";
import Socials from "@/components/Socials.astro";
import StructuredData from "@/components/StructuredData.astro";
import { SITE, SOCIALS } from "@/config";
import Layout from "@/layouts/Layout.astro";
import { getCollection } from "astro:content";
import type { CollectionEntry } from "astro:content";

const allPosts = await getCollection("blog", ({ data }) => !data.draft);
const sortedPosts = allPosts.sort((a, b) => {
  const aDate = a.data.pubDatetime || new Date();
  const bDate = b.data.pubDatetime || new Date();
  return new Date(bDate).getTime() - new Date(aDate).getTime();
});

const generateSlug = (post: CollectionEntry<"blog">) => {
  const postId = post.id;
  const yearDirMatch = postId.match(/^(\d{4})\/(.*)/);
  if (yearDirMatch) return postId;

  const pubDate = post.data.pubDatetime;
  const year = pubDate
    ? pubDate.getFullYear().toString()
    : postId.match(/^(\d{4})-\d{2}-\d{2}/)
      ? postId.substring(0, 4)
      : new Date().getFullYear().toString();

  return `${year}/${postId}`;
};

const featuredPosts = sortedPosts.slice(0, 3).map((post) => ({
  title: post.data.title,
  description: post.data.description || "",
  date: new Date(post.data.pubDatetime).toLocaleDateString("en-US", {
    month: "short",
    day: "numeric",
    year: "numeric",
  }),
  slug: generateSlug(post),
}));

const guidedPaths = [
  {
    title: "Enterprise architecture and transformation",
    body: "For people dealing with architecture, platform decisions, integration mess, and large-scale transformation pressure.",
    href: "/resume",
    cta: "See work",
  },
  {
    title: "AI systems and agentic workflows",
    body: "For people trying to separate real operational AI from prompt theatre and demo energy.",
    href: "/tags/ai",
    cta: "Explore AI writing",
  },
  {
    title: "Built systems and proof-of-work",
    body: "For people who want to see actual artifacts, experiments, integrations, and product-shaped systems.",
    href: "/projects",
    cta: "See projects",
  },
];

const selectedWriting = [
  {
    title: "Enterprise architecture",
    description: "Architecture, transformation, and the system-level tradeoffs that matter when delivery gets real.",
    href: "/posts/2026/2026-02-05-ai-doesn-t-replace-architecture-it-makes-good-architecture-non-negotiable",
    article: "AI doesn’t replace architecture, it makes good architecture non-negotiable",
  },
  {
    title: "AI systems in the wild",
    description: "Less prompt-theatre, more operational reality: agents, constraints, controls, and what actually breaks.",
    href: "/posts/2026/2026-03-17-most-enterprise-ai-still-feels-like-letting-a-very-confident-intern-loose-in-your-systems",
    article: "Most enterprise AI still feels like letting a very confident intern loose in your systems",
  },
  {
    title: "Built systems and experiments",
    description: "Proof-of-work through real implementations, not just opinions about what someone should build.",
    href: "/posts/2026/2026-03-31-household-chores-home-assistant-agent-tasks",
    article: "Household Chores for Home Assistant",
  },
];

const themes = [
  {
    title: "Transformation",
    body: "Architecture, operating-model friction, integration complexity, and the ugly tradeoffs that appear when big companies try to change without breaking the core business.",
    href: "/resume",
  },
  {
    title: "AI systems",
    body: "What happens when AI leaves the demo stage and has to work through tools, permissions, brittle context, governance, and production reality.",
    href: "/tags/ai",
  },
  {
    title: "Applied software",
    body: "Home Assistant tooling, workflow automation, content systems, and experiments designed to survive actual use instead of just looking clever.",
    href: "/projects",
  },
];
---

<Layout description={SITE.desc}>
  <StructuredData type="WebSite" data={{}} />
  <StructuredData type="Person" data={{}} />
  <Header />
  <main id="main-content" data-layout="index">
    <section id="hero" class="pt-6 pb-10">
      <div class="rounded-3xl border border-accent/15 bg-gradient-to-br from-accent/8 via-background to-background p-6 sm:p-8">
        <div class="flex flex-col items-start gap-5 sm:flex-row sm:gap-6">
          <a href="/about" class="group mx-auto block sm:mx-0">
            <img
              src="/hero.png"
              alt={SITE.title}
              class="h-32 w-32 rounded-full object-cover transition-all duration-300 group-hover:scale-105 group-hover:shadow-xl"
            />
          </a>
          <div class="flex-1 pt-1 text-center sm:text-left">
            <div class="mb-3 inline-flex items-center rounded-full border border-accent/20 bg-background/80 px-3 py-1 text-[11px] font-medium uppercase tracking-[0.12em] text-foreground/65">
              Enterprise architecture • AI systems • proof-of-work
            </div>
            <h1 class="my-2 inline-block max-w-3xl text-3xl font-bold tracking-tight sm:my-3 sm:text-4xl sm:leading-tight">
              Hi, I'm {SITE.title}.
            </h1>
            <p class="max-w-2xl text-base leading-8 text-skin-base/82">
              {SITE.desc}
            </p>
            <p class="mt-3 max-w-2xl text-sm leading-7 text-skin-base/62">
              Less hype, more systems thinking: practical notes on enterprise integration, large-scale transformation, agentic workflows, autonomy, and the infrastructure behind what actually works.
            </p>
            {
              SOCIALS.filter((social) => social.active).length > 0 && (
                <div class="mt-4 flex flex-row items-center justify-center sm:justify-start">
                  <Socials />
                </div>
              )
            }
          </div>
        </div>
      </div>
    </section>

    <Hr />

    <section class="py-10">
      <div class="mb-6 flex items-center justify-between">
        <div>
          <h2 class="text-xl font-semibold">Start from the right path</h2>
          <p class="mt-2 max-w-2xl text-sm leading-7 text-skin-base/70">
            Different people land here for different reasons. This should make that easier.
          </p>
        </div>
      </div>

      <div class="grid gap-4 md:grid-cols-3">
        {guidedPaths.map((path) => (
          <a href={path.href} class="rounded-2xl border border-border bg-background/70 p-5 transition-all hover:border-accent/35 hover:bg-background/90">
            <h3 class="mb-2 font-semibold">{path.title}</h3>
            <p class="mb-4 text-sm leading-7 text-skin-base/70">{path.body}</p>
            <div class="inline-flex items-center gap-2 text-sm font-medium text-accent">
              {path.cta}
              <IconArrowRight class="inline-block" />
            </div>
          </a>
        ))}
      </div>
    </section>

    <Hr />

    <section class="py-10">
      <div class="mb-5 flex items-center justify-between">
        <div>
          <h2 class="text-xl font-semibold">Core themes</h2>
          <p class="mt-2 max-w-2xl text-sm leading-7 text-skin-base/70">
            These are the three themes the rest of the site keeps orbiting around.
          </p>
        </div>
        <LinkButton href="/about" class="text-sm">
          More about me
          <IconArrowRight class="inline-block" />
        </LinkButton>
      </div>

      <div class="grid gap-4 md:grid-cols-3">
        {themes.map((theme) => (
          <a href={theme.href} class="rounded-2xl border border-skin-line bg-skin-fill/25 p-5 transition-all hover:border-accent/35 hover:bg-skin-fill/40">
            <h3 class="mb-2 font-semibold">{theme.title}</h3>
            <p class="text-sm leading-7 text-skin-base/70">{theme.body}</p>
          </a>
        ))}
      </div>
    </section>

    <Hr />

    <section class="py-10">
      <div class="rounded-2xl border border-accent/18 bg-gradient-to-br from-accent/10 to-accent/5 p-6 sm:p-8">
        <div class="mb-6 flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
          <div>
            <h2 class="text-xl font-semibold">Selected writing</h2>
            <p class="mt-2 max-w-2xl text-sm text-skin-base/70">
              Start with the pieces that best reflect how I think and what I tend to build around.
            </p>
          </div>
          <LinkButton href="/posts/" class="text-sm">
            Browse everything
            <IconArrowRight class="inline-block" />
          </LinkButton>
        </div>

        <div class="grid gap-4 md:grid-cols-3">
          {selectedWriting.map((item) => (
            <a href={item.href} class="block rounded-2xl border border-accent/15 bg-background/70 p-5 transition-all hover:border-accent/40 hover:bg-background/85">
              <h3 class="mb-2 font-semibold">{item.title}</h3>
              <p class="mb-4 text-sm leading-7 text-skin-base/70">{item.description}</p>
              <p class="text-sm font-medium text-foreground/85">{item.article}</p>
            </a>
          ))}
        </div>
      </div>
    </section>

    <Hr />

    <section class="py-10">
      <div class="mb-5 flex items-center justify-between">
        <div>
          <h2 class="text-xl font-semibold">Recent writing</h2>
          <p class="mt-2 text-sm text-skin-base/70">Latest posts, if you want the freshest signal instead of the curated entry points above.</p>
        </div>
        <LinkButton href="/posts/" class="text-sm">
          All Posts
          <IconArrowRight class="inline-block" />
        </LinkButton>
      </div>

      {featuredPosts.length > 0 ? (
        <div class="grid gap-4 md:grid-cols-3">
          {featuredPosts.map((post) => (
            <a href={`/posts/${post.slug}`} class="group block rounded-2xl border border-skin-line bg-skin-fill/25 p-5 transition-all hover:border-accent/45 hover:bg-skin-fill/45">
              <div class="mb-2 text-xs text-skin-base/50">{post.date}</div>
              <h3 class="mb-2 line-clamp-2 font-medium transition-colors group-hover:text-accent">{post.title}</h3>
              <p class="line-clamp-3 text-sm text-skin-base/70">{post.description}</p>
            </a>
          ))}
        </div>
      ) : (
        <div class="rounded-lg border border-skin-line bg-skin-fill/30 p-6 text-center">
          <p class="text-skin-base/70">No posts yet, check back soon.</p>
        </div>
      )}
    </section>
  </main>
  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)?.dataset?.layout;
    if (indexLayout) {
      sessionStorage.setItem("backUrl", "/");
    }
  });
</script>
