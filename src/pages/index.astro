---
import type { CollectionEntry } from "astro:content";
import { getCollection } from "astro:content";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import Footer from "@/components/Footer.astro";
import Header from "@/components/Header.astro";
import Hr from "@/components/Hr.astro";
import LinkButton from "@/components/LinkButton.astro";
import Socials from "@/components/Socials.astro";
import StructuredData from "@/components/StructuredData.astro";
import { SITE, SOCIALS } from "@/config";
import Layout from "@/layouts/Layout.astro";

const allPosts = await getCollection("blog", ({ data }) => !data.draft);
const sortedPosts = allPosts.sort((a, b) => {
  const aDate = a.data.pubDatetime || new Date();
  const bDate = b.data.pubDatetime || new Date();
  return new Date(bDate).getTime() - new Date(aDate).getTime();
});

const generateSlug = (post: CollectionEntry<"blog">) => {
  const postId = post.id;
  const yearDirMatch = postId.match(/^(\d{4})\/(.*)/);
  if (yearDirMatch) return postId;

  const pubDate = post.data.pubDatetime;
  const year = pubDate
    ? pubDate.getFullYear().toString()
    : postId.match(/^(\d{4})-\d{2}-\d{2}/)
      ? postId.substring(0, 4)
      : new Date().getFullYear().toString();

  return `${year}/${postId}`;
};

const featuredPosts = sortedPosts.slice(0, 3).map((post) => ({
  title: post.data.title,
  description: post.data.description || "",
  image: typeof post.data.heroImage === "string" ? post.data.heroImage : "",
  date: new Date(post.data.pubDatetime).toLocaleDateString("en-US", {
    month: "short",
    day: "numeric",
    year: "numeric",
  }),
  slug: generateSlug(post),
}));

const [leadPost, ...supportingPosts] = featuredPosts;

const proofOfWorkItems = [
  {
    title: "Personal Agent Toolchain",
    description:
      "The operating layer behind Jason: planning, QA, memory, evaluation, docs, and durable task handoff.",
    href: "/projects",
    label: "Agent ops",
  },
  {
    title: "Household Chores",
    description:
      "A Home Assistant task system built around actual household coordination and chat-based interaction.",
    href: "/posts/2026/2026-03-31-household-chores-home-assistant-agent-tasks",
    label: "Home Assistant",
  },
  {
    title: "Home Brief",
    description:
      "Persistent daily briefs across assistant and dashboard surfaces instead of one-shot generated messages.",
    href: "/posts/2026/2026-04-30-home-brief-home-assistant-daily-briefs-that-persist",
    label: "Integration",
  },
];
---

<Layout description={SITE.desc}>
  <StructuredData type="WebSite" data={{}} />
  <StructuredData type="Person" data={{}} />
  <Header />
  <main id="main-content" data-layout="index">
    <section id="hero" class="pt-6 pb-10">
      <div class="relative rounded-3xl border border-accent/15 bg-gradient-to-br from-accent/8 via-background to-background p-6 sm:p-8">
        <div class="flex flex-col items-start gap-5 sm:flex-row sm:gap-6">
          <a href="/about" class="group mx-auto block sm:mx-0">
            <img
              src="/hero.png"
              alt={SITE.title}
              class="h-32 w-32 rounded-full object-cover transition-all duration-300 group-hover:scale-105 group-hover:shadow-xl"
            />
          </a>
          <div class="flex-1 pt-1 text-center sm:text-left">
            <div class="mb-3 inline-flex items-center rounded-full border border-accent/20 bg-background/80 px-3 py-1 text-[11px] font-medium uppercase tracking-[0.12em] text-foreground/65">
              Enterprise architecture • AI systems • proof-of-work
            </div>
            <h1 class="my-2 inline-block max-w-3xl text-3xl font-bold tracking-tight sm:my-3 sm:text-4xl sm:leading-tight">
              Hi, I'm {SITE.title}.
            </h1>
            <p class="max-w-2xl text-base leading-8 text-skin-base/82">
              {SITE.desc}
            </p>
            <p class="mt-3 max-w-2xl text-sm leading-7 text-skin-base/62">
              Less hype, more systems thinking: practical notes on enterprise integration, large-scale transformation, agentic workflows, autonomy, and the infrastructure behind what actually works.
            </p>
            {
              SOCIALS.filter((social) => social.active).length > 0 && (
                <div class="mt-4 flex flex-row items-center justify-center sm:justify-start">
                  <Socials />
                </div>
              )
            }
          </div>
        </div>
      </div>
    </section>

    <Hr />

    <section class="py-10">
      <div class="mb-6 flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
        <div>
          <h2 class="text-xl font-semibold">Welcome to my brain</h2>
          <p class="mt-2 max-w-2xl text-sm text-skin-base/70">
            A few pieces that show the ideas I keep pulling apart: systems, autonomy, work, and what actually holds up.
          </p>
        </div>
        <LinkButton href="/posts" class="text-sm">
          All writing
          <IconArrowRight class="inline-block" />
        </LinkButton>
      </div>

      {leadPost && (
        <div class="grid gap-4">
          <a href={`/posts/${leadPost.slug}`} class="group grid overflow-hidden rounded-2xl border border-accent/20 bg-accent/8 transition-all hover:border-accent/45 hover:bg-accent/10 md:grid-cols-[0.9fr_1.1fr]">
            {leadPost.image && (
              <div class="flex min-h-56 items-center justify-center border-b border-accent/15 bg-background/70 p-4 md:border-r md:border-b-0">
                <img
                  src={leadPost.image}
                  alt=""
                  class="max-h-72 w-full object-contain transition-transform duration-300 group-hover:scale-[1.01]"
                  loading="lazy"
                  decoding="async"
                />
              </div>
            )}
            <div class="p-5 sm:p-6">
              <div class="mb-3 inline-flex items-center rounded-full border border-accent/25 bg-background/80 px-3 py-1 text-[11px] font-medium uppercase tracking-[0.12em] text-accent">
                Featured
              </div>
              <h3 class="max-w-2xl text-xl font-semibold tracking-tight transition-colors group-hover:text-accent sm:text-2xl">
                {leadPost.title}
              </h3>
              <p class="mt-3 max-w-2xl text-sm leading-7 text-skin-base/72">{leadPost.description}</p>
              <p class="mt-5 text-sm font-medium text-foreground/85">
                Read article <IconArrowRight class="inline-block" />
              </p>
            </div>
          </a>
          <div class="grid gap-4 md:grid-cols-2">
            {supportingPosts.map((post) => (
              <a href={`/posts/${post.slug}`} class="group block rounded-2xl border border-border bg-background/70 p-5 transition-all hover:border-accent/35 hover:bg-background/90">
                <div class="mb-2 text-xs text-skin-base/50">{post.date}</div>
                <h3 class="mb-2 line-clamp-2 font-medium transition-colors group-hover:text-accent">{post.title}</h3>
                <p class="line-clamp-2 text-sm leading-7 text-skin-base/70">{post.description}</p>
              </a>
            ))}
          </div>
        </div>
      )}
    </section>

    <section class="pb-10">
      <div class="mb-5 flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
        <div>
          <h2 class="text-xl font-semibold">Proof of work</h2>
          <p class="mt-2 max-w-xl text-sm text-skin-base/70">
            A few built systems behind the writing. Enough proof, not a portfolio wall.
          </p>
        </div>
        <LinkButton href="/projects" class="text-sm">
          See proof of work
          <IconArrowRight class="inline-block" />
        </LinkButton>
      </div>

      <div class="grid gap-4 md:grid-cols-3">
        {proofOfWorkItems.map((item) => (
          <a href={item.href} class="group block rounded-2xl border border-border bg-background/70 p-5 transition-all hover:border-accent/35 hover:bg-background/90">
            <div class="mb-3 inline-flex items-center rounded-full border border-border/70 bg-muted/25 px-2.5 py-1 text-[11px] font-medium uppercase tracking-[0.12em] text-foreground/65">
              {item.label}
            </div>
            <h3 class="mb-2 font-semibold transition-colors group-hover:text-accent">{item.title}</h3>
            <p class="line-clamp-3 text-sm leading-7 text-skin-base/70">{item.description}</p>
          </a>
        ))}
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)?.dataset?.layout;
    if (indexLayout) {
      sessionStorage.setItem("backUrl", "/");
    }
  });
</script>
