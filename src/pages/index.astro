---
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import Footer from "@/components/Footer.astro";
import Header from "@/components/Header.astro";
import Hr from "@/components/Hr.astro";
import LinkButton from "@/components/LinkButton.astro";
import Socials from "@/components/Socials.astro";
import StructuredData from "@/components/StructuredData.astro";
import { SITE, SOCIALS } from "@/config";
import Layout from "@/layouts/Layout.astro";
import { getCollection } from "astro:content";

// Get actual blog posts
const allPosts = await getCollection("blog", ({ data }) => !data.draft);
const sortedPosts = allPosts.sort((a, b) => {
  const aDate = a.data.pubDatetime || new Date();
  const bDate = b.data.pubDatetime || new Date();
  return new Date(bDate).getTime() - new Date(aDate).getTime();
});
const featuredPosts = sortedPosts.slice(0, 3).map(post => ({
  title: post.data.title,
  description: post.data.description || "",
  date: new Date(post.data.pubDatetime).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }),
  slug: post.slug
}));
---

<Layout description={SITE.desc}>
  <StructuredData type="WebSite" data={{}} />
  <StructuredData type="Person" data={{}} />
  <Header />
  <main id="main-content" data-layout="index">
    
    {/* Hero */}
    <section id="hero" class="pt-6 pb-8">
      <div class="flex flex-col sm:flex-row items-start gap-4">
        <a href="/about" class="block mx-auto sm:mx-0 group">
          <img 
            src="/hero.png" 
            alt={SITE.title}
            class="w-32 h-32 rounded-full object-cover flex-shrink-0 transition-all duration-300 group-hover:scale-105 group-hover:shadow-xl"
          />
        </a>
        <div class="flex-1 text-center sm:text-left">
          <h1 class="my-2 inline-block text-2xl font-bold sm:my-3 sm:text-3xl">
            Hi, I'm {SITE.title}.
          </h1>
          <p class="text-skin-base/80">
            {SITE.desc}
          </p>
          {
            SOCIALS.filter((social) => social.active).length > 0 && (
              <div class="mt-3 flex flex-row items-center justify-center sm:justify-start">
                <Socials />
              </div>
            )
          }
        </div>
      </div>
    </section>

    <Hr />

    {/* Newsletter Section */}
    <section class="py-12">
      <div class="max-w-2xl mx-auto text-center">

        <!-- Value props -->
        <div class="grid md:grid-cols-3 gap-4 mb-8 text-left">
          <div class="p-4 bg-skin-fill/50 border border-skin-line rounded-xl">
            <div class="text-2xl mb-2">🤖</div>
            <h3 class="font-semibold text-sm mb-1">AI Agents</h3>
            <p class="text-xs text-skin-base/70">What's working in production, not just demos</p>
          </div>
          
          <div class="p-4 bg-skin-fill/50 border border-skin-line rounded-xl">
            <div class="text-2xl mb-2">🚗</div>
            <h3 class="font-semibold text-sm mb-1">Tesla & FSD</h3>
            <p class="text-xs text-skin-base/70">Data-driven analysis of autonomy progress</p>
          </div>
          
          <div class="p-4 bg-skin-fill/50 border border-skin-line rounded-xl">
            <div class="text-2xl mb-2">⚡</div>
            <h3 class="font-semibold text-sm mb-1">Integration</h3>
            <p class="text-xs text-skin-base/70">Patterns from enterprise architecture</p>
          </div>
        </div>

        <!-- Signup Form -->
        <div class="bg-gradient-to-br from-accent/10 to-accent/5 border border-accent/20 rounded-2xl p-6 mb-6">
          <p class="text-skin-base/70 mb-4">No spam. Unsubscribe anytime. Weekly delivery.</p>
          
          <form 
            action="https://buttondown.email/api/emails/embed-subscribe/nikolajflojgaard" 
            method="post" 
            target="popupwindow"
            onsubmit="window.open('https://buttondown.email/nikolajflojgaard', 'popupwindow')"
            class="flex flex-col sm:flex-row gap-3 max-w-md mx-auto"
          >
            <input 
              type="email" 
              name="email" 
              placeholder="you@example.com" 
              required
              class="flex-1 px-4 py-3 bg-skin-fill border border-skin-line rounded-lg text-skin-base placeholder-skin-base/50 focus:outline-none focus:border-accent"
            />
            <button 
              type="submit"
              class="px-6 py-3 bg-accent hover:opacity-90 text-white font-medium rounded-lg transition-colors whitespace-nowrap"
            >
              Subscribe
            </button>
          </form>
          
          <p class="text-skin-base/50 text-sm mt-4">
            Join 0 others (for now — be the first!)
          </p>
        </div>
      </div>
    </section>

    <Hr />

    <!-- Featured Content Teaser -->
    <section class="py-12">
      <div class="flex items-center justify-between mb-6">
        <h2 class="text-xl font-semibold">From the blog</h2>
        <LinkButton href="/posts/">
          All Posts
          <IconArrowRight class="inline-block" />
        </LinkButton>
      </div>
      
      {featuredPosts.length > 0 ? (
        <div class="grid md:grid-cols-3 gap-4">
          {featuredPosts.map((post) => (
            <a href={`/posts/${post.slug}`} class="block p-4 bg-skin-fill/30 border border-skin-line rounded-lg hover:border-accent/50 hover:bg-skin-fill/50 transition-all group">
              <div class="text-skin-base/50 text-xs mb-2">{post.date}</div>
              <h3 class="font-medium mb-2 line-clamp-2 group-hover:text-accent transition-colors">{post.title}</h3>
              <p class="text-sm text-skin-base/70 line-clamp-2">{post.description}</p>
            </a>
          ))}
        </div>
      ) : (
        <div class="p-6 bg-skin-fill/30 border border-skin-line rounded-lg text-center">
          <p class="text-skin-base/70">No posts yet — check back soon!</p>
        </div>
      )}
    </section>

  </main>
  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset?.layout;
    if (indexLayout) {
      sessionStorage.setItem("backUrl", "/");
    }
  });
</script>
