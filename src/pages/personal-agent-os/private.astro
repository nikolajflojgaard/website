---
import Footer from "@/components/Footer.astro";
import Header from "@/components/Header.astro";
import { SITE } from "@/config";
import Layout from "@/layouts/Layout.astro";

const hasSupabaseConfig = Boolean(
  import.meta.env.PUBLIC_SUPABASE_URL && import.meta.env.PUBLIC_SUPABASE_ANON_KEY
);
---

<Layout
  title={`Private Console | ${SITE.title}`}
  description="Private login and read-only cards for Personal Agent OS."
>
  <Header />
  <main id="main-content" class="w-full pb-16">
    <section class="site-shell pt-8 pb-6">
      <p class="eyebrow">Personal Agent OS</p>
      <h1 class="mt-4 text-3xl font-semibold tracking-tight text-foreground sm:text-4xl">Private console</h1>
      <p class="mt-4 max-w-2xl text-base leading-8 text-foreground/78">
        Login is client-side with Supabase public keys only. Cards load after authentication and remain read-only.
      </p>
    </section>

    <section class="site-shell pb-8">
      <div class="private-shell" data-has-config={hasSupabaseConfig ? "true" : "false"}>
        <article class:list={["panel", !hasSupabaseConfig && "panel-warning"]} aria-live="polite">
          <h2>Auth setup</h2>
          {
            hasSupabaseConfig ? (
              <p>
                Supabase client keys are present. Sign in with Google to continue.
              </p>
            ) : (
              <p>
                Setup needed: missing `PUBLIC_SUPABASE_URL` and/or `PUBLIC_SUPABASE_ANON_KEY`. Add them before login
                can work.
              </p>
            )
          }
          <p id="auth-status" class="status-chip status-muted">Checking session...</p>
          <p id="auth-error" class="status-chip status-danger" hidden></p>
        </article>

        <article class="panel">
          <div class="panel-head">
            <h2>Sign in</h2>
            <button id="signout" type="button" class="btn btn-ghost" disabled>Sign out</button>
          </div>
          <p id="allowed-email-note" class="muted-note" hidden></p>
          <p id="provider-status" class="muted-note" aria-live="polite"></p>
          <div class="actions">
            <button id="signin-google" type="button" class="btn" disabled>
              Continue with Google
            </button>
          </div>

          <dl class="user-meta">
            <div>
              <dt>User</dt>
              <dd id="user-email">Not signed in</dd>
            </div>
            <div>
              <dt>User ID</dt>
              <dd id="user-id">-</dd>
            </div>
          </dl>
        </article>

        <article id="private-app" class="panel private-app" hidden>
          <div class="panel-head">
            <h2 id="private-app-heading">Dashboard</h2>
            <span id="app-sync-status" class="status-chip status-muted">Locked</span>
          </div>

          <nav class="private-tabs" aria-label="Private console sections">
            <button type="button" class="private-tab is-active" data-private-tab="dashboard">Dashboard</button>
            <button type="button" class="private-tab" data-private-tab="cronjobs">Cronjobs</button>
            <button type="button" class="private-tab" data-private-tab="skills">Skills</button>
            <button type="button" class="private-tab" data-private-tab="chat">Chat</button>
          </nav>

          <section class="private-panel is-active" data-private-panel="dashboard">
            <div class="control-grid">
              <article class="control-tile">
                <span>Auth</span>
                <strong id="dashboard-auth">Signed out</strong>
              </article>
              <article class="control-tile">
                <span>Cronjobs</span>
                <strong id="dashboard-cron-count">0 tracked</strong>
              </article>
              <article class="control-tile">
                <span>Skills</span>
                <strong id="dashboard-skill-count">0 visible</strong>
              </article>
              <article class="control-tile">
                <span>Bridge</span>
                <strong id="dashboard-bridge">Static shell</strong>
              </article>
            </div>

            <div class="panel-subhead">
              <h3>Agent cards</h3>
              <span class="muted-note">Read-only after auth</span>
            </div>
            <p id="cards-status" class="muted-note">Sign in to load cards from `public.agent_os_cards`.</p>
            <div id="cards" class="cards-grid" aria-live="polite"></div>
          </section>

          <section class="private-panel" data-private-panel="cronjobs">
            <p class="muted-note">Current scheduler inventory, sanitized for the private console.</p>
            <div id="cronjobs-list" class="ops-list" aria-live="polite"></div>
          </section>

          <section class="private-panel" data-private-panel="skills">
            <p class="muted-note">Page visibility toggles only. Runtime skill enablement still lives in OpenClaw.</p>
            <div id="skills-list" class="ops-list" aria-live="polite"></div>
          </section>

          <section class="private-panel" data-private-panel="chat">
            <form id="chat-form" class="chat-form">
              <label for="chat-prompt">Prompt Jason</label>
              <textarea id="chat-prompt" name="prompt" rows="5" placeholder="Write the next thing you want Jason to handle."></textarea>
              <div class="chat-actions">
                <button class="btn" type="submit">Queue prompt</button>
                <span id="chat-status" class="muted-note" aria-live="polite">Agent bridge not connected yet.</span>
              </div>
            </form>
            <div id="chat-log" class="chat-log" aria-live="polite"></div>
          </section>
        </article>
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<script>
  // @ts-nocheck
  import { createClient } from "@supabase/supabase-js";

  const supabaseUrl = import.meta.env.PUBLIC_SUPABASE_URL ?? "";
  const supabaseAnonKey = import.meta.env.PUBLIC_SUPABASE_ANON_KEY ?? "";
  const allowedEmail = (import.meta.env.PUBLIC_AGENT_OS_ALLOWED_EMAIL ?? "").trim().toLowerCase();
  const hasConfig = Boolean(supabaseUrl && supabaseAnonKey);

  const authStatusEl = document.querySelector("#auth-status");
  const authErrorEl = document.querySelector("#auth-error");
  const allowedEmailNoteEl = document.querySelector("#allowed-email-note");
  const providerStatusEl = document.querySelector("#provider-status");
  const googleButton = document.querySelector("#signin-google");
  const signOutButton = document.querySelector("#signout");
  const userEmailEl = document.querySelector("#user-email");
  const userIdEl = document.querySelector("#user-id");
  const privateAppEl = document.querySelector("#private-app");
  const privateAppHeadingEl = document.querySelector("#private-app-heading");
  const appSyncStatusEl = document.querySelector("#app-sync-status");
  const dashboardAuthEl = document.querySelector("#dashboard-auth");
  const dashboardCronCountEl = document.querySelector("#dashboard-cron-count");
  const dashboardSkillCountEl = document.querySelector("#dashboard-skill-count");
  const dashboardBridgeEl = document.querySelector("#dashboard-bridge");
  const cardsStatusEl = document.querySelector("#cards-status");
  const cardsEl = document.querySelector("#cards");
  const cronJobsListEl = document.querySelector("#cronjobs-list");
  const skillsListEl = document.querySelector("#skills-list");
  const chatFormEl = document.querySelector("#chat-form");
  const chatPromptEl = document.querySelector("#chat-prompt");
  const chatStatusEl = document.querySelector("#chat-status");
  const chatLogEl = document.querySelector("#chat-log");
  const privateTabEls = [...document.querySelectorAll("[data-private-tab]")];
  const privatePanelEls = [...document.querySelectorAll("[data-private-panel]")];
  const headerMenuItemsEl = document.querySelector("#menu-items");
  const originalHeaderMenu = headerMenuItemsEl?.innerHTML ?? "";

  const cronJobs = [
    {
      name: "Daily brief preflight",
      cadence: "07:20 Europe/Copenhagen",
      summary: "Checks the daily brief inputs before publish.",
      status: "ok",
      enabled: true,
    },
    {
      name: "Home Brief publish",
      cadence: "07:28 Europe/Copenhagen",
      summary: "Publishes the morning home brief.",
      status: "ok",
      enabled: true,
    },
    {
      name: "Daily brief",
      cadence: "07:30 Europe/Copenhagen",
      summary: "Runs the main daily brief lane.",
      status: "ok",
      enabled: true,
    },
    {
      name: "EV/FSD monitor",
      cadence: "Daily morning",
      summary: "Watches EV/FSD signals and reports useful changes.",
      status: "ok",
      enabled: true,
    },
    {
      name: "Dealer monitor",
      cadence: "Daily morning",
      summary: "Watches configured dealer inventory signals.",
      status: "ok",
      enabled: true,
    },
    {
      name: "Jason backup sync",
      cadence: "Monday 02:00",
      summary: "Backs up curated OpenClaw workspace files.",
      status: "ok",
      enabled: true,
    },
    {
      name: "Drive drop-folder sweep",
      cadence: "Weekdays every 2 hours",
      summary: "Sweeps configured Drive drop folders during working hours.",
      status: "ok",
      enabled: true,
    },
    {
      name: "Stock playbook buy-territory check",
      cadence: "Biweekly Wednesday 12:00",
      summary: "Checks stock playbook candidates against buy-zone rules.",
      status: "ok",
      enabled: true,
    },
    {
      name: "Home Assistant config backup",
      cadence: "Biweekly Wednesday 12:00",
      summary: "Syncs Home Assistant config backup state.",
      status: "ok",
      enabled: true,
    },
    {
      name: "Stock buy-zone alerts",
      cadence: "Scheduled market check",
      summary: "Checks configured buy-zone alert conditions.",
      status: "ok",
      enabled: true,
    },
    {
      name: "Family message watcher",
      cadence: "Disabled interval",
      summary: "Paused watcher lane for family-message context.",
      status: "paused",
      enabled: false,
    },
    {
      name: "Direct message watcher",
      cadence: "Disabled interval",
      summary: "Paused watcher lane for direct-message context.",
      status: "paused",
      enabled: false,
    },
  ];

  const skills = [
    ["github", "GitHub issues, PRs, CI, and repo operations."],
    ["gog", "Google Workspace mail, calendar, Drive, Sheets, Docs, and contacts."],
    ["gog-oauth-recovery", "Phone/browser Google OAuth recovery for headless use."],
    ["stock-playbook-review", "Nikolaj's five-gate stock review workflow."],
    ["architecture-doc-kissify", "Turns heavy architecture docs into sharper KISS markdown."],
    ["openapi-spec-workflow", "Creates and renders OpenAPI contracts."],
    ["healthcheck", "Host security hardening and exposure checks."],
    ["repo-fleet-maintainer", "Scans and maintains multiple repos safely."],
    ["agent-memory-distiller", "Distills recent work into compact durable memory."],
    ["diagram-maker", "Creates architecture and workflow diagrams."],
    ["openhue", "Controls Philips Hue lights and scenes."],
    ["weather", "Current weather and forecasts."],
  ].map(([name, summary]) => ({ name, summary }));

  const showAuthError = (message) => {
    if (!authErrorEl) return;
    authErrorEl.hidden = false;
    authErrorEl.textContent = message;
  };

  const clearAuthError = () => {
    if (!authErrorEl) return;
    authErrorEl.hidden = true;
    authErrorEl.textContent = "";
  };

  const setAuthStatus = (label, tone = "muted") => {
    if (!authStatusEl) return;
    authStatusEl.textContent = label;
    authStatusEl.className = `status-chip status-${tone}`;
  };

  const setProviderStatus = (message) => {
    if (!providerStatusEl) return;
    providerStatusEl.textContent = message;
  };

  const clearCards = () => {
    if (!cardsEl) return;
    cardsEl.innerHTML = "";
  };

  const setCardsStatus = (message) => {
    if (!cardsStatusEl) return;
    cardsStatusEl.textContent = message;
  };

  const providerState = {
    google: true,
  };

  const setControlsEnabled = (enabled) => {
    if (googleButton instanceof HTMLButtonElement) googleButton.disabled = !enabled || !providerState.google;
  };

  const formatDate = (value) => {
    if (!value) return "";
    const parsed = new Date(value);
    if (Number.isNaN(parsed.getTime())) return "";
    return new Intl.DateTimeFormat("en", {
      year: "numeric",
      month: "short",
      day: "numeric",
      hour: "2-digit",
      minute: "2-digit",
    }).format(parsed);
  };

  const renderCards = (cards) => {
    if (!cardsEl) return;
    clearCards();

    if (!cards.length) {
      setCardsStatus("No cards yet.");
      return;
    }

    setCardsStatus(`Loaded ${cards.length} card${cards.length === 1 ? "" : "s"}.`);

    for (const card of cards) {
      const article = document.createElement("article");
      article.className = "card-item";

      const head = document.createElement("div");
      head.className = "card-head";

      const title = document.createElement("h3");
      title.textContent = card.title ?? "Untitled card";

      const badge = document.createElement("span");
      badge.className = "status-chip status-muted";
      badge.textContent = card.status ?? "note";

      head.append(title, badge);

      const summary = document.createElement("p");
      summary.textContent = card.summary ?? "";

      const meta = document.createElement("div");
      meta.className = "card-meta";

      const updated = document.createElement("small");
      const formattedDate = formatDate(card.updated_at);
      updated.textContent = formattedDate ? `Updated ${formattedDate}` : "";
      meta.appendChild(updated);

      if (card.link_url) {
        const link = document.createElement("a");
        link.href = card.link_url;
        link.textContent = "Open";
        link.rel = "noopener noreferrer";
        link.target = "_blank";
        meta.appendChild(link);
      }

      article.append(head, summary, meta);
      cardsEl.appendChild(article);
    }
  };

  const isAllowedUser = (user) => {
    if (!allowedEmail) return true;
    const email = user?.email?.toLowerCase();
    return Boolean(email) && email === allowedEmail;
  };

  if (!hasConfig) {
    setAuthStatus("Setup needed", "warning");
    setControlsEnabled(false);
    setProviderStatus("Add Supabase public env vars to enable login.");
    setCardsStatus("Setup needed before cards can be loaded.");
  } else {
    const supabase = createClient(supabaseUrl, supabaseAnonKey, {
      auth: {
        autoRefreshToken: true,
        persistSession: true,
        detectSessionInUrl: true,
      },
    });

    setControlsEnabled(true);
    clearAuthError();

    if (allowedEmail && allowedEmailNoteEl) {
      allowedEmailNoteEl.hidden = false;
      allowedEmailNoteEl.textContent = "This console is restricted to the configured allowed email.";
    }

    const getRedirectTo = () => new URL("/personal-agent-os/private", window.location.origin).toString();

    const cleanAuthUrl = () => {
      window.history.replaceState({}, document.title, getRedirectTo());
    };

    const syncProviderState = async () => {
      try {
        const response = await fetch(`${supabaseUrl}/auth/v1/settings`, {
          headers: {
            apikey: supabaseAnonKey,
          },
        });

        if (!response.ok) return;

        const settings = await response.json();
        providerState.google = settings?.external?.google !== false;

        if (!providerState.google && googleButton instanceof HTMLButtonElement) {
          googleButton.textContent = "Google disabled in Supabase";
        }

        const disabledProviders = [!providerState.google && "Google"].filter(Boolean);

        setProviderStatus(
          disabledProviders.length ? `${disabledProviders.join(" and ")} disabled in Supabase Auth.` : ""
        );
        setControlsEnabled(true);
      } catch {
        setProviderStatus("Could not verify enabled Supabase auth providers.");
      }
    };

    await syncProviderState();

    const activatePrivateTab = (tabName) => {
      const normalizedTab = ["dashboard", "cronjobs", "skills", "chat"].includes(tabName) ? tabName : "dashboard";

      for (const button of privateTabEls) {
        button.classList.toggle("is-active", button.dataset.privateTab === normalizedTab);
      }

      for (const panel of privatePanelEls) {
        panel.classList.toggle("is-active", panel.dataset.privatePanel === normalizedTab);
      }

      if (privateAppHeadingEl) {
        privateAppHeadingEl.textContent = normalizedTab.charAt(0).toUpperCase() + normalizedTab.slice(1);
      }
    };

    const setPrivateHeaderNav = (enabled) => {
      if (!headerMenuItemsEl) return;

      if (!enabled) {
        headerMenuItemsEl.innerHTML = originalHeaderMenu;
        return;
      }

      headerMenuItemsEl.innerHTML = ["dashboard", "cronjobs", "skills", "chat"]
        .map(
          (tab) =>
            `<li class="col-span-2"><a href="#${tab}" data-private-nav="${tab}">${tab.charAt(0).toUpperCase() + tab.slice(1)}</a></li>`
        )
        .join("");

      for (const link of headerMenuItemsEl.querySelectorAll("[data-private-nav]")) {
        link.addEventListener("click", (event) => {
          event.preventDefault();
          activatePrivateTab(link.dataset.privateNav);
          privateAppEl?.scrollIntoView({ behavior: "smooth", block: "start" });
        });
      }
    };

    const bindPrivateTabs = () => {
      for (const button of privateTabEls) {
        button.addEventListener("click", () => {
          activatePrivateTab(button.dataset.privateTab);
        });
      }
    };

    const renderCronJobs = () => {
      if (!cronJobsListEl) return;
      cronJobsListEl.innerHTML = "";

      for (const job of cronJobs) {
        const item = document.createElement("article");
        item.className = "ops-item";
        item.innerHTML = `
          <div>
            <h3>${job.name}</h3>
            <p>${job.summary}</p>
            <small>${job.cadence}</small>
          </div>
          <span class="status-chip ${job.enabled ? "status-ok" : "status-muted"}">${job.enabled ? job.status : "disabled"}</span>
        `;
        cronJobsListEl.appendChild(item);
      }

      if (dashboardCronCountEl) {
        dashboardCronCountEl.textContent = `${cronJobs.filter((job) => job.enabled).length}/${cronJobs.length} active`;
      }
    };

    const getSkillVisibility = () => {
      try {
        return JSON.parse(localStorage.getItem("agent-os-skill-visibility") ?? "{}");
      } catch {
        return {};
      }
    };

    const setSkillVisibility = (visibility) => {
      localStorage.setItem("agent-os-skill-visibility", JSON.stringify(visibility));
    };

    const renderSkills = () => {
      if (!skillsListEl) return;
      const visibility = getSkillVisibility();
      skillsListEl.innerHTML = "";

      for (const skill of skills) {
        const enabled = visibility[skill.name] ?? true;
        const item = document.createElement("article");
        item.className = "ops-item";
        item.innerHTML = `
          <div>
            <h3>${skill.name}</h3>
            <p>${skill.summary}</p>
          </div>
          <label class="toggle-row">
            <input type="checkbox" ${enabled ? "checked" : ""} data-skill-toggle="${skill.name}" />
            <span>${enabled ? "shown" : "hidden"}</span>
          </label>
        `;
        skillsListEl.appendChild(item);
      }

      for (const toggle of skillsListEl.querySelectorAll("[data-skill-toggle]")) {
        toggle.addEventListener("change", () => {
          const nextVisibility = getSkillVisibility();
          nextVisibility[toggle.dataset.skillToggle] = toggle.checked;
          setSkillVisibility(nextVisibility);
          renderSkills();
        });
      }

      if (dashboardSkillCountEl) {
        const visibleCount = skills.filter((skill) => getSkillVisibility()[skill.name] ?? true).length;
        dashboardSkillCountEl.textContent = `${visibleCount}/${skills.length} visible`;
      }
    };

    const appendChatLog = (message, tone = "muted") => {
      if (!chatLogEl) return;
      const item = document.createElement("article");
      item.className = "chat-entry";
      item.innerHTML = `<span class="status-chip status-${tone}">${tone}</span><p>${message}</p>`;
      chatLogEl.prepend(item);
    };

    const loadCards = async (user) => {
      if (!user) {
        clearCards();
        setCardsStatus("Sign in to load cards from `public.agent_os_cards`.");
        if (privateAppEl instanceof HTMLElement) privateAppEl.hidden = true;
        setPrivateHeaderNav(false);
        return;
      }

      if (!isAllowedUser(user)) {
        clearCards();
        setCardsStatus("Signed in account is not allowed for this console.");
        if (privateAppEl instanceof HTMLElement) privateAppEl.hidden = true;
        setPrivateHeaderNav(false);
        return;
      }

      setCardsStatus("Loading cards...");

      const { data, error } = await supabase
        .from("agent_os_cards")
        .select("id,title,summary,status,updated_at,link_url")
        .order("updated_at", { ascending: false })
        .limit(24);

      if (error) {
        const isPolicyError = error.code === "42501" || /rls/i.test(error.message);
        const isMissingTable = error.code === "42P01" || /agent_os_cards/.test(error.message);

        if (isPolicyError) {
          setCardsStatus("Cards are blocked by RLS/policy. Confirm SELECT policy for authenticated users.");
        } else if (isMissingTable) {
          setCardsStatus("Table `public.agent_os_cards` is missing. Run the setup SQL.");
        } else {
          setCardsStatus("Unable to load cards right now.");
        }

        return;
      }

      renderCards(data ?? []);
    };

    const applyUserState = async (user) => {
      if (userEmailEl) {
        userEmailEl.textContent = user?.email ?? "Not signed in";
      }
      if (userIdEl) {
        userIdEl.textContent = user?.id ?? "-";
      }

      if (signOutButton instanceof HTMLButtonElement) {
        signOutButton.disabled = !user;
      }

      if (!user) {
        setAuthStatus("Signed out", "muted");
        if (dashboardAuthEl) dashboardAuthEl.textContent = "Signed out";
        if (appSyncStatusEl) {
          appSyncStatusEl.textContent = "Locked";
          appSyncStatusEl.className = "status-chip status-muted";
        }
        await loadCards(null);
        return;
      }

      if (!isAllowedUser(user)) {
        setAuthStatus("Signed in (blocked by allowed email)", "warning");
        await loadCards(user);
        return;
      }

      setAuthStatus("Signed in", "ok");
      if (dashboardAuthEl) dashboardAuthEl.textContent = user.email ?? "Signed in";
      if (dashboardBridgeEl) dashboardBridgeEl.textContent = "Google session";
      if (appSyncStatusEl) {
        appSyncStatusEl.textContent = "Unlocked";
        appSyncStatusEl.className = "status-chip status-ok";
      }
      if (privateAppEl instanceof HTMLElement) privateAppEl.hidden = false;
      setPrivateHeaderNav(true);
      renderCronJobs();
      renderSkills();
      activatePrivateTab("dashboard");
      await loadCards(user);
    };

    if (googleButton instanceof HTMLButtonElement) {
      googleButton.addEventListener("click", async () => {
        clearAuthError();

        const { error } = await supabase.auth.signInWithOAuth({
          provider: "google",
          options: {
            redirectTo: getRedirectTo(),
          },
        });

        if (error) {
          showAuthError(`Google sign-in failed: ${error.message}`);
        }
      });
    }

    if (chatFormEl instanceof HTMLFormElement) {
      chatFormEl.addEventListener("submit", async (event) => {
        event.preventDefault();

        const formData = new FormData(chatFormEl);
        const prompt = String(formData.get("prompt") ?? "").trim();
        if (!prompt) {
          if (chatStatusEl) chatStatusEl.textContent = "Write a prompt first.";
          return;
        }

        const { data: sessionData } = await supabase.auth.getSession();
        const user = sessionData.session?.user;
        if (!user || !isAllowedUser(user)) {
          if (chatStatusEl) chatStatusEl.textContent = "Sign in with the allowed account first.";
          return;
        }

        if (chatStatusEl) chatStatusEl.textContent = "Queueing prompt...";

        const { error } = await supabase.from("agent_os_prompts").insert({
          owner_id: user.id,
          prompt,
          status: "queued",
        });

        if (error) {
          localStorage.setItem("agent-os-chat-draft", prompt);
          if (chatStatusEl) chatStatusEl.textContent = "Prompt bridge table missing. Draft kept locally.";
          appendChatLog("Prompt kept locally until the Supabase prompt queue exists.", "warning");
          return;
        }

        if (chatPromptEl instanceof HTMLTextAreaElement) chatPromptEl.value = "";
        if (chatStatusEl) chatStatusEl.textContent = "Prompt queued for Jason.";
        appendChatLog(prompt, "ok");
      });
    }

    if (signOutButton instanceof HTMLButtonElement) {
      signOutButton.addEventListener("click", async () => {
        clearAuthError();

        const { error } = await supabase.auth.signOut();
        if (error) {
          showAuthError(`Sign-out failed: ${error.message}`);
        }
      });
    }

    supabase.auth.onAuthStateChange((_, session) => {
      void applyUserState(session?.user ?? null);
    });

    const finishAuthRedirect = async () => {
      const url = new URL(window.location.href);
      const hashParams = new URLSearchParams(window.location.hash.slice(1));
      const errorDescription =
        url.searchParams.get("error_description") ||
        url.searchParams.get("error") ||
        hashParams.get("error_description") ||
        hashParams.get("error");

      if (errorDescription) {
        showAuthError(`Sign-in callback failed: ${decodeURIComponent(errorDescription)}`);
        return;
      }

      const code = url.searchParams.get("code");
      if (!code) return;

      setAuthStatus("Finishing sign-in...", "muted");

      const { error } = await supabase.auth.exchangeCodeForSession(code);
      if (error) {
        showAuthError(`Sign-in callback failed: ${error.message}`);
        setAuthStatus("Sign-in callback failed", "danger");
        return;
      }

      cleanAuthUrl();
    };

    bindPrivateTabs();

    await finishAuthRedirect();

    const { data, error } = await supabase.auth.getSession();
    if (error) {
      showAuthError(`Session check failed: ${error.message}`);
      setAuthStatus("Auth check failed", "danger");
    }

    await applyUserState(data.session?.user ?? null);
  }
</script>

