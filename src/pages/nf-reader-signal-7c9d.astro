---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";

const posts = (await getCollection("blog", ({ data }) => !data.draft && !data.unlisted))
  .map((post) => {
    const yearDirMatch = post.id.match(/^(\d{4})\/(.*)/);
    const pubDate = post.data.pubDatetime;
    const year = pubDate ? pubDate.getFullYear().toString() : new Date().getFullYear().toString();
    const slug = yearDirMatch ? post.id : `${year}/${post.id.replace(/^\d{4}-\d{2}-\d{2}-/, "")}`;
    return {
      title: post.data.title,
      path: `/posts/${slug}`,
      type: "post",
      pubDatetime: post.data.pubDatetime.toISOString(),
    };
  })
  .sort((a, b) => b.pubDatetime.localeCompare(a.pubDatetime));

const routes = [
  { title: "Home", path: "/", type: "page" },
  { title: "Posts", path: "/posts", type: "page" },
  { title: "About", path: "/about", type: "page" },
  { title: "Resume", path: "/resume", type: "page" },
  ...posts,
];
---

<Layout title="Reader signal" description="Private-ish readership stats">
  <Header />
  <main class="mx-auto w-full max-w-5xl px-4 pb-16 mt-8">
    <div class="mb-8">
      <h1 class="text-3xl font-bold">Reader signal</h1>
      <p class="mt-2 text-sm opacity-70">
        Lightweight private-ish counters for page and post visits. Good for signal, not for courtroom-grade analytics.
      </p>
    </div>

    <div class="mb-6 stats-grid">
      <div class="stat-card">
        <div class="stat-label">Total tracked views</div>
        <div class="stat-value" id="total-views">—</div>
      </div>
      <div class="stat-card">
        <div class="stat-label">Tracked routes</div>
        <div class="stat-value">{routes.length}</div>
      </div>
      <div class="stat-card">
        <div class="stat-label">Most read route</div>
        <div class="stat-value stat-small" id="top-route">—</div>
      </div>
    </div>

    <div class="table-wrap">
      <table class="stats-table">
        <thead>
          <tr>
            <th>Title</th>
            <th>Path</th>
            <th>Type</th>
            <th>Views</th>
          </tr>
        </thead>
        <tbody id="stats-body">
          {routes.map((route) => (
            <tr data-title={route.title} data-path={route.path} data-type={route.type}>
              <td>{route.title}</td>
              <td><code>{route.path}</code></td>
              <td>{route.type}</td>
              <td data-count>…</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </main>
  <Footer />
</Layout>

<script is:inline>
  const COUNTER_NAMESPACE = "nikolajflojgaard_me";

  function counterKey(pathname) {
    const normalized = pathname === "/" ? "home" : pathname.replace(/\/+$/g, "") || "/";
    return normalized
      .replace(/^\//, "")
      .replace(/[^a-zA-Z0-9/_-]/g, "-")
      .replace(/\//g, "__");
  }

  async function loadStats() {
    const rows = Array.from(document.querySelectorAll("#stats-body tr"));
    const results = [];
    for (const row of rows) {
      const path = row.getAttribute("data-path") || "/";
      const title = row.getAttribute("data-title") || path;
      const countCell = row.querySelector("[data-count]");
      try {
        const res = await fetch(`https://api.countapi.xyz/get/${COUNTER_NAMESPACE}/${encodeURIComponent(counterKey(path))}`);
        if (!res.ok) {
          if (countCell) countCell.textContent = "0";
          results.push({ title, path, value: 0, row });
          continue;
        }
        const data = await res.json();
        const value = Number(data?.value || 0);
        if (countCell) countCell.textContent = String(value);
        results.push({ title, path, value, row });
      } catch {
        if (countCell) countCell.textContent = "0";
        results.push({ title, path, value: 0, row });
      }
    }

    results.sort((a, b) => b.value - a.value);
    const body = document.getElementById("stats-body");
    if (body) {
      for (const item of results) body.appendChild(item.row);
    }
    const total = results.reduce((sum, item) => sum + item.value, 0);
    const top = results[0];
    const totalEl = document.getElementById("total-views");
    const topEl = document.getElementById("top-route");
    if (totalEl) totalEl.textContent = String(total);
    if (topEl) topEl.textContent = top ? `${top.title} (${top.value})` : "—";
  }

  loadStats();
</script>

<style>
  .stats-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
  }
  .stat-card {
    border: 1px solid var(--border);
    border-radius: 16px;
    padding: 1rem;
    background: color-mix(in srgb, var(--background) 92%, var(--accent) 8%);
  }
  .stat-label {
    font-size: 0.85rem;
    opacity: 0.65;
    margin-bottom: 0.4rem;
  }
  .stat-value {
    font-size: 1.8rem;
    font-weight: 700;
  }
  .stat-small {
    font-size: 1rem;
    line-height: 1.3;
  }
  .table-wrap {
    overflow-x: auto;
    border: 1px solid var(--border);
    border-radius: 16px;
  }
  .stats-table {
    width: 100%;
    border-collapse: collapse;
  }
  .stats-table th,
  .stats-table td {
    padding: 0.85rem 1rem;
    border-bottom: 1px solid var(--border);
    text-align: left;
  }
  .stats-table th {
    font-size: 0.85rem;
    opacity: 0.7;
  }
  .stats-table code {
    font-size: 0.85rem;
  }
  @media (max-width: 720px) {
    .stats-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
