---
import ContentSection from "@/components/ContentSection.astro";
import Footer from "@/components/Footer.astro";
import Header from "@/components/Header.astro";
import InfoCard from "@/components/InfoCard.astro";
import { SITE } from "@/config";
import Layout from "@/layouts/Layout.astro";

const featuredProjects = [
  {
    name: "Personal Agent Toolchain",
    role: "Agent workflow design, evaluation design, public skill packaging, CI documentation rollout, and personal automation hardening.",
    summary:
      "A growing public toolchain for running a personal AI assistant like an operating system instead of a clever chat window.",
    problem:
      "Most agent examples stop at the impressive demo. Real personal agents also need scoped work packets, QA, memory boundaries, durable waits, evaluation, repo maintenance, and docs that stay honest in CI.",
    constraints:
      "Had to be useful in a private local assistant setup while still being generalized, sanitized, documented, and public enough for reuse.",
    whyItMatters:
      "It turns repeated assistant failure modes into reusable operating procedures: workbench runs, red-team review, memory distillation, TaskFlow handoff, behavior evaluation, and repo documentation checks.",
    links: [
      {
        label: "Read the new write-up",
        href: "/posts/2026/2026-06-25-building-a-personal-agent-toolchain",
      },
      { label: "Read the write-up", href: "/posts/2026/2026-06-15-agent-ops-beats-agent-demos" },
      {
        label: "Agent Workbench",
        href: "https://github.com/nikolajflojgaard/agent-workbench",
      },
      {
        label: "QA / Red Team",
        href: "https://github.com/nikolajflojgaard/agent-qa-red-team",
      },
      {
        label: "Evaluation Harness",
        href: "https://github.com/nikolajflojgaard/agent-evaluation-harness",
      },
      {
        label: "Code Doc Pipeline",
        href: "https://github.com/nikolajflojgaard/code-doc-pipeline",
      },
    ],
  },
  {
    name: "Household Chores",
    homeAssistant: true,
    role: "Product design, integration design, Home Assistant implementation, and assistant workflow orchestration.",
    summary:
      "A Home Assistant task system built for actual household coordination, not just another database with a nicer skin.",
    problem:
      "Most task systems break in the real world because adding, assigning, and completing chores still takes too much effort. They store tasks fine. They are bad interfaces.",
    constraints:
      "Had to work across household context, chat interaction, automation logic, and a UI that people would actually use without resenting it.",
    whyItMatters:
      "This project connects product thinking, Home Assistant, automation, and chat-based interaction into one practical system. It is a better example of full-stack systems design than a simple dashboard or toy app.",
    links: [
      {
        label: "Read the write-up",
        href: "/posts/2026/2026-03-31-household-chores-home-assistant-agent-tasks",
      },
      { label: "GitHub", href: "https://github.com/nikolajflojgaard/household-chores" },
    ],
  },
  {
    name: "Home Brief",
    homeAssistant: true,
    role: "Integration architecture, UI surface design, assistant publishing contract, and Home Assistant implementation.",
    summary:
      "A Home Assistant integration for generating and rendering a persistent daily brief across assistant and dashboard surfaces.",
    problem:
      "AI-generated summaries are usually ephemeral. They show up once in chat, then disappear. This project turns them into stable, reusable household information.",
    constraints:
      "Needed a cleaner separation between generation and rendering so the brief could persist and stay stable across surfaces instead of being recomputed ad hoc.",
    whyItMatters:
      "It bridges assistant output, structured payloads, and in-home presentation instead of treating AI as a one-shot message generator.",
    links: [
      {
        label: "Read the write-up",
        href: "/posts/2026/2026-04-30-home-brief-home-assistant-daily-briefs-that-persist",
      },
      { label: "GitHub", href: "https://github.com/nikolajflojgaard/home-assistant-home-brief" },
    ],
  },
  {
    name: "Home Assistant HACS Template",
    homeAssistant: true,
    role: "Tooling and integration scaffolding for faster future delivery.",
    summary:
      "A reusable foundation for building Home Assistant integrations faster without rewriting the same scaffolding every time.",
    problem:
      "Starting a custom integration from scratch often means redoing the same setup work before any actual product value gets built.",
    constraints:
      "Needed to be generic enough to reuse, but opinionated enough to speed up real implementation instead of becoming another empty starter kit.",
    whyItMatters:
      "This is the kind of tooling work that compounds. It makes future integrations cleaner, faster to ship, and easier to maintain.",
    links: [
      {
        label: "Read the write-up",
        href: "/posts/2026/2026-02-14-playing-around-with-home-assistant-maybe-this-template-is-for-you",
      },
      { label: "GitHub", href: "https://github.com/nikolajflojgaard/home-assistant-hacs-template" },
    ],
  },
];

const agentToolchainRepos = [
  {
    name: "Agent Workbench",
    label: "Run setup",
    href: "https://github.com/nikolajflojgaard/agent-workbench",
    summary:
      "Turns a messy request into objective, lanes, briefs, state, artifacts, gates, and final-report scaffolding.",
  },
  {
    name: "Agent QA / Red Team",
    label: "Review",
    href: "https://github.com/nikolajflojgaard/agent-qa-red-team",
    summary:
      "Adds a read-only second pass for bugs, weak claims, privacy issues, missing validation, and release risk.",
  },
  {
    name: "Agent Memory Distiller",
    label: "Memory",
    href: "https://github.com/nikolajflojgaard/agent-memory-distiller",
    summary:
      "Separates raw daily notes from compact long-term memory so the assistant remembers signal, not clutter.",
  },
  {
    name: "TaskFlow Agent Runner",
    label: "Durable work",
    href: "https://github.com/nikolajflojgaard/taskflow-agent-runner",
    summary:
      "Defines the wait, resume, approval pause, child-task, artifact, finish, fail, and handoff pattern.",
  },
  {
    name: "Agent Evaluation Harness",
    label: "Measurement",
    href: "https://github.com/nikolajflojgaard/agent-evaluation-harness",
    summary:
      "Scores agent runs against fixtures and rubrics for honesty, validation, safety, usefulness, and regression.",
  },
  {
    name: "Code Doc Pipeline",
    label: "Docs rail",
    href: "https://github.com/nikolajflojgaard/code-doc-pipeline",
    summary:
      "Generates repo docs and Mermaid diagrams, then uses CI drift checks to keep documentation honest.",
  },
  {
    name: "Skill Publisher Pipeline",
    label: "Release rail",
    href: "https://github.com/nikolajflojgaard/skill-publisher-pipeline",
    summary:
      "Packages skills and proposals into release-ready repos, artifacts, validation reports, and publishing checklists.",
  },
];

const jasonPrinciples = [
  "Useful beats impressive.",
  "Systems beat one-off hacks.",
  "Clarity beats fluff.",
  "Shipping beats endless planning.",
  "Good taste matters.",
  "AI is only valuable when it survives real workflows.",
];

const jasonCapabilities = [
  "Shape product ideas into sharper, more buildable directions.",
  "Write and edit with a more human, less synthetic cadence.",
  "Build and ship changes across code, content, and automation systems.",
  "Structure workflows, task routing, and operational glue.",
  "Connect systems and reduce the chaos that grows between teams, tools, and abstractions.",
];

const jasonBuiltTogether = [
  "Household Chores",
  "Home Brief",
  "Personal Agent Toolchain",
  "Skill Publisher Pipeline",
  "Code Doc Pipeline rollout",
  "This website and its positioning/content system",
  "Workflow and memory systems",
  "Automation and integration experiments",
];

const jasonLimits = [
  "Not a replacement for deep domain ownership.",
  "Not magic when the underlying system is messy and nobody wants to decide.",
  "Not a substitute for real taste if nobody curates the output.",
  "Less useful when goals stay vague on purpose.",
];

const experiments = [
  {
    name: "Family Ops",
    label: "Concept",
    summary:
      "A mobile-first family logistics and smart scheduling concept built around modular building blocks instead of a tightly coupled mess.",
  },
  {
    name: "Agentic workflow experiments",
    label: "AI Systems",
    summary:
      "Ongoing work around AI-assisted workflows, orchestration, memory, task routing, and the gap between impressive demos and dependable systems.",
  },
  {
    name: "Publishing and content systems",
    label: "Publishing",
    summary:
      "The site itself is also an evolving experiment in structured publishing, better content packaging, and building a cleaner system around writing.",
  },
];
---

<Layout title={`Projects | ${SITE.title}`} description={`Selected projects and experiments by ${SITE.title}.`}>
  <Header />
  <main id="main-content" class="site-shell pb-16">
    <section class="mt-8 mb-10 rounded-2xl border border-accent/20 bg-gradient-to-br from-accent/10 to-accent/5 p-6 sm:p-8">
      <div class="max-w-3xl">
        <h1 class="text-3xl font-semibold tracking-tight sm:text-4xl">Projects</h1>
        <p class="mt-3 text-base leading-8 text-foreground/80">
          Selected things I have built, shipped, or keep pushing forward. Less portfolio theatre, more proof-of-work, systems thinking, and applied architecture.
        </p>
      </div>
    </section>

    <ContentSection
      title="Personal agent toolchain"
      description="The current public repo stack behind Jason: the operating layer for planning, waiting, reviewing, remembering, measuring, and documenting agent work."
    >
      <InfoCard className="mb-5 overflow-hidden border-accent/25 bg-accent/8 p-0 shadow-sm">
        <div class="grid gap-0 md:grid-cols-[1.05fr_0.95fr]">
          <div class="p-5 sm:p-6">
            <div class="mb-3 inline-flex items-center rounded-full border border-accent/30 bg-background/70 px-3 py-1 text-xs font-semibold uppercase tracking-[0.12em] text-accent">
              New public stack
            </div>
            <h2 class="text-2xl font-semibold tracking-tight">From chat helper to operating system</h2>
            <p class="mt-3 text-sm leading-7 text-foreground/74">
              This is the newer agent work: a set of repos that make the assistant more dependable when work crosses repos, waits on CI, needs a critic, or has to prove that something is really shipped.
            </p>
            <div class="mt-5 flex flex-wrap gap-3">
              <a
                href="/posts/2026/2026-06-25-building-a-personal-agent-toolchain"
                class="inline-flex rounded-lg border border-accent/35 bg-accent px-4 py-2 text-sm font-semibold text-white hover:bg-accent/90"
              >
                Read the toolchain article
              </a>
              <a
                href="https://github.com/nikolajflojgaard/agent-orchestration-hub"
                class="inline-flex rounded-lg border border-border bg-background/80 px-4 py-2 text-sm font-medium hover:border-accent/35 hover:text-accent"
              >
                Orchestration hub
              </a>
            </div>
          </div>
          <div class="border-t border-border/70 bg-background/65 p-5 md:border-t-0 md:border-l sm:p-6">
            <p class="mb-3 text-sm font-semibold uppercase tracking-[0.12em] text-foreground/55">What it is for</p>
            <ul class="space-y-2 text-sm leading-7 text-foreground/74">
              <li>Make ambiguous work concrete before touching code.</li>
              <li>Keep long-running tasks alive without stale chat context.</li>
              <li>Catch overclaims before they become public updates.</li>
              <li>Promote useful memory and leave noisy notes behind.</li>
              <li>Measure whether the agent is actually improving.</li>
            </ul>
          </div>
        </div>
      </InfoCard>

      <div class="grid gap-4 md:grid-cols-2">
        {agentToolchainRepos.map((repo) => (
          <InfoCard title={repo.name} className="bg-muted/20 p-5" bodyClassName="text-sm leading-7 text-foreground/72">
            <div class="mb-3">
              <span class="inline-flex items-center rounded-full border border-border/70 bg-background/85 px-2.5 py-1 text-[11px] font-medium uppercase tracking-[0.12em] text-foreground/65">
                {repo.label}
              </span>
            </div>
            <p>{repo.summary}</p>
            <a href={repo.href} class="mt-4 inline-flex rounded-lg border border-border px-3 py-1.5 text-sm font-medium hover:border-accent/35 hover:text-accent">
              GitHub
            </a>
          </InfoCard>
        ))}
      </div>
    </ContentSection>

    <ContentSection
      title="Featured projects"
      description="The stronger examples of how I think, build, and structure real systems."
    >
      <div class="space-y-5">
        {featuredProjects.map((project, index) => (
          <InfoCard className="shadow-sm">
            <div class="mb-3 flex flex-wrap items-center gap-3">
              <span class="inline-flex h-8 min-w-8 items-center justify-center rounded-full bg-accent/12 px-3 text-sm font-semibold text-accent">
                {index + 1}
              </span>
              <h3 class="text-xl font-semibold">{project.name}</h3>
              {project.homeAssistant && (
                <span class="inline-flex items-center rounded-full border border-sky-200 bg-sky-50 px-3 py-1 text-xs font-medium uppercase tracking-[0.12em] text-sky-700 dark:border-sky-900/60 dark:bg-sky-950/50 dark:text-sky-300">
                  Home Assistant
                </span>
              )}
            </div>

            <p class="text-base leading-8 text-foreground/84">{project.summary}</p>

            <div class="mt-5 flex flex-wrap gap-3 text-sm leading-7 text-foreground/72">
              <div class="inline-flex max-w-full items-start gap-2 rounded-full border border-border/70 bg-muted/18 px-3 py-1.5">
                <span class="font-semibold text-foreground">Role:</span>
                <span>{project.role}</span>
              </div>
              <div class="inline-flex max-w-full items-start gap-2 rounded-full border border-border/70 bg-muted/18 px-3 py-1.5">
                <span class="font-semibold text-foreground">Constraint:</span>
                <span>{project.constraints}</span>
              </div>
            </div>

            <div class="mt-4 space-y-3 text-sm leading-7 text-foreground/72">
              <p><span class="font-semibold text-foreground">Problem:</span> {project.problem}</p>
              <p><span class="font-semibold text-foreground">Why it matters:</span> {project.whyItMatters}</p>
            </div>

            <div class="mt-5 flex flex-wrap gap-3">
              {project.links.map((link) => (
                <a href={link.href} class="inline-flex rounded-lg border border-border px-4 py-2 text-sm font-medium hover:border-accent/35 hover:text-accent">
                  {link.label}
                </a>
              ))}
            </div>
          </InfoCard>
        ))}
      </div>
    </ContentSection>

    <ContentSection
      title="Working With Jason"
      description="A practical AI collaboration model shaped around systems thinking, writing, product direction, execution, and actual delivery instead of chatbot theatre."
      className="rounded-2xl border border-border bg-background/70 p-6 sm:p-8"
    >
      <div class="mb-6 grid gap-4 md:grid-cols-2">
        <InfoCard title="How Jason thinks" className="bg-muted/20 p-5" bodyClassName="text-sm leading-7 text-foreground/72">
          <ul class="list-disc space-y-1 pl-5">
            {jasonPrinciples.map((item) => <li>{item}</li>)}
          </ul>
        </InfoCard>
        <InfoCard title="What Jason can do" className="bg-muted/20 p-5" bodyClassName="text-sm leading-7 text-foreground/72">
          <ul class="list-disc space-y-1 pl-5">
            {jasonCapabilities.map((item) => <li>{item}</li>)}
          </ul>
        </InfoCard>
      </div>

      <div class="mb-6 grid gap-4 md:grid-cols-2">
        <InfoCard title="What we have built together" className="bg-muted/20 p-5" bodyClassName="text-sm leading-7 text-foreground/72">
          <ul class="list-disc space-y-1 pl-5">
            {jasonBuiltTogether.map((item) => <li>{item}</li>)}
          </ul>
        </InfoCard>
        <InfoCard title="Where it is less useful" className="bg-muted/20 p-5" bodyClassName="text-sm leading-7 text-foreground/72">
          <ul class="list-disc space-y-1 pl-5">
            {jasonLimits.map((item) => <li>{item}</li>)}
          </ul>
        </InfoCard>
      </div>

      <p class="text-sm leading-7 text-foreground/72">
        The useful version of this is not “talk to a chatbot.” It is having a system that can think across writing, product direction, architecture, workflows, and execution without losing the thread every five minutes. The point is leverage, not novelty.
      </p>
    </ContentSection>

    <ContentSection
      title="Experiments"
      description="Smaller bets, evolving systems, and things that are still becoming clearer."
    >
      <div class="grid gap-4 md:grid-cols-3">
        {experiments.map((experiment) => (
          <InfoCard title={experiment.name} className="bg-muted/20 p-5" bodyClassName="text-sm leading-7 text-foreground/72">
            <div class="mb-3">
              <span class="inline-flex items-center rounded-full border border-border/70 bg-background/85 px-2.5 py-1 text-[11px] font-medium uppercase tracking-[0.12em] text-foreground/65">
                {experiment.label}
              </span>
            </div>
            <p>{experiment.summary}</p>
          </InfoCard>
        ))}
      </div>
    </ContentSection>
  </main>
  <Footer />
</Layout>
