---
import ContentSection from "@/components/ContentSection.astro";
import Footer from "@/components/Footer.astro";
import Header from "@/components/Header.astro";
import InfoCard from "@/components/InfoCard.astro";
import { SITE } from "@/config";
import Layout from "@/layouts/Layout.astro";

const featuredProjects = [
  {
    name: "Household Chores",
    homeAssistant: true,
    summary:
      "A Home Assistant task system built for actual household coordination, not just another database with a nicer skin.",
    problem:
      "Most task systems break in the real world because adding, assigning, and completing chores still takes too much effort. They store tasks fine. They are bad interfaces.",
    whyItMatters:
      "This project connects product thinking, Home Assistant, automation, and chat-based interaction into one practical system. It is a better example of full-stack systems design than a simple dashboard or toy app.",
    links: [
      { label: "Read the write-up", href: "/posts/2026/2026-03-31-household-chores-home-assistant-agent-tasks" },
      { label: "GitHub", href: "https://github.com/nikolajflojgaard/household-chores" },
    ],
  },
  {
    name: "Home Brief",
    homeAssistant: true,
    summary:
      "A Home Assistant integration for generating and rendering a persistent daily brief across assistant and dashboard surfaces.",
    problem:
      "AI-generated summaries are usually ephemeral. They show up once in chat, then disappear. This project turns them into stable, reusable household information.",
    whyItMatters:
      "It bridges assistant output, structured payloads, and in-home presentation instead of treating AI as a one-shot message generator.",
    links: [
      { label: "Read the write-up", href: "/posts/2026/2026-04-30-home-brief-home-assistant-daily-briefs-that-persist" },
      { label: "GitHub", href: "https://github.com/nikolajflojgaard/home-assistant-home-brief" },
    ],
  },
  {
    name: "Home Assistant HACS Template",
    homeAssistant: true,
    summary:
      "A reusable foundation for building Home Assistant integrations faster without rewriting the same scaffolding every time.",
    problem:
      "Starting a custom integration from scratch often means redoing the same setup work before any actual product value gets built.",
    whyItMatters:
      "This is the kind of tooling work that compounds. It makes future integrations cleaner, faster to ship, and easier to maintain.",
    links: [
      { label: "Read the write-up", href: "/posts/2026/2026-02-14-playing-around-with-home-assistant-maybe-this-template-is-for-you" },
      { label: "GitHub", href: "https://github.com/nikolajflojgaard/home-assistant-hacs-template" },
    ],
  },
];

const jasonPrinciples = [
  "Useful beats impressive.",
  "Systems beat one-off hacks.",
  "Clarity beats fluff.",
  "Shipping beats endless planning.",
  "Good taste matters.",
  "AI is only valuable when it survives real workflows.",
];

const jasonCapabilities = [
  "Shape product ideas into sharper, more buildable directions.",
  "Write and edit with a more human, less synthetic cadence.",
  "Build and ship changes across code, content, and automation systems.",
  "Structure workflows, task routing, and operational glue.",
  "Connect systems and reduce the chaos that grows between teams, tools, and abstractions.",
];

const jasonBuiltTogether = [
  "Household Chores",
  "Home Brief",
  "This website and its positioning/content system",
  "Workflow and memory systems",
  "Automation and integration experiments",
];

const jasonLimits = [
  "Not a replacement for deep domain ownership.",
  "Not magic when the underlying system is messy and nobody wants to decide.",
  "Not a substitute for real taste if nobody curates the output.",
  "Less useful when goals stay vague on purpose.",
];

const experiments = [
  {
    name: "Family Ops",
    label: "Concept",
    summary:
      "A mobile-first family logistics and smart scheduling concept built around modular building blocks instead of a tightly coupled mess.",
  },
  {
    name: "Agentic workflow experiments",
    label: "AI Systems",
    summary:
      "Ongoing work around AI-assisted workflows, orchestration, memory, task routing, and the gap between impressive demos and dependable systems.",
  },
  {
    name: "Publishing and content systems",
    label: "Publishing",
    summary:
      "The site itself is also an evolving experiment in structured publishing, better content packaging, and building a cleaner system around writing.",
  },
];
---

<Layout title={`Projects | ${SITE.title}`} description={`Selected projects and experiments by ${SITE.title}.`}>
  <Header />
  <main id="main-content" class="mx-auto w-full max-w-3xl px-4 pb-16">
    <section class="mt-8 mb-10 rounded-2xl border border-accent/20 bg-gradient-to-br from-accent/10 to-accent/5 p-6 sm:p-8">
      <h1 class="text-3xl font-semibold tracking-tight sm:text-4xl">Projects</h1>
      <p class="mt-3 max-w-2xl text-base leading-8 text-foreground/80">
        Selected things I have built, shipped, or keep pushing forward. Less portfolio theatre, more useful systems.
      </p>
    </section>

    <ContentSection
      title="Featured projects"
      description="The stronger examples of how I think, build, and ship."
    >
      <div class="space-y-5">
        {featuredProjects.map((project, index) => (
          <InfoCard>
            <div class="mb-3 flex flex-wrap items-center gap-3">
              <span class="inline-flex h-8 min-w-8 items-center justify-center rounded-full bg-accent/12 px-3 text-sm font-semibold text-accent">
                {index + 1}
              </span>
              <h3 class="text-xl font-semibold">{project.name}</h3>
              {project.homeAssistant && (
                <span class="inline-flex items-center rounded-full border border-sky-200 bg-sky-50 px-3 py-1 text-xs font-medium uppercase tracking-[0.12em] text-sky-700 dark:border-sky-900/60 dark:bg-sky-950/50 dark:text-sky-300">
                  Home Assistant
                </span>
              )}
            </div>

            <p class="text-base leading-8 text-foreground/84">{project.summary}</p>

            <div class="mt-4 space-y-3 text-sm leading-7 text-foreground/72">
              <p><span class="font-semibold text-foreground">Problem:</span> {project.problem}</p>
              <p><span class="font-semibold text-foreground">Why it matters:</span> {project.whyItMatters}</p>
            </div>

            <div class="mt-5 flex flex-wrap gap-3">
              {project.links.map((link) => (
                <a href={link.href} class="inline-flex rounded-lg border border-border px-4 py-2 text-sm font-medium hover:text-accent">
                  {link.label}
                </a>
              ))}
            </div>
          </InfoCard>
        ))}
      </div>
    </ContentSection>

    <ContentSection
      title="Working With Jason"
      description="A practical AI collaboration model shaped around systems thinking, writing, product direction, execution, and actual delivery instead of chatbot theatre."
      className="rounded-2xl border border-border bg-background/70 p-6 sm:p-8"
    >
      <div class="mb-6 grid gap-4 md:grid-cols-2">
        <InfoCard title="How Jason thinks" className="bg-muted/20 p-5" bodyClassName="text-sm leading-7 text-foreground/72">
          <ul class="list-disc space-y-1 pl-5">
            {jasonPrinciples.map((item) => <li>{item}</li>)}
          </ul>
        </InfoCard>
        <InfoCard title="What Jason can do" className="bg-muted/20 p-5" bodyClassName="text-sm leading-7 text-foreground/72">
          <ul class="list-disc space-y-1 pl-5">
            {jasonCapabilities.map((item) => <li>{item}</li>)}
          </ul>
        </InfoCard>
      </div>

      <div class="mb-6 grid gap-4 md:grid-cols-2">
        <InfoCard title="What we have built together" className="bg-muted/20 p-5" bodyClassName="text-sm leading-7 text-foreground/72">
          <ul class="list-disc space-y-1 pl-5">
            {jasonBuiltTogether.map((item) => <li>{item}</li>)}
          </ul>
        </InfoCard>
        <InfoCard title="Where it is less useful" className="bg-muted/20 p-5" bodyClassName="text-sm leading-7 text-foreground/72">
          <ul class="list-disc space-y-1 pl-5">
            {jasonLimits.map((item) => <li>{item}</li>)}
          </ul>
        </InfoCard>
      </div>

      <p class="text-sm leading-7 text-foreground/72">
        The useful version of this is not “talk to a chatbot.” It is having a system that can think across writing, product direction, architecture, workflows, and execution without losing the thread every five minutes. The point is leverage, not novelty.
      </p>
    </ContentSection>

    <ContentSection
      title="Experiments"
      description="Smaller bets, evolving systems, and things that are still becoming clearer."
    >
      <div class="grid gap-4 md:grid-cols-3">
        {experiments.map((experiment) => (
          <InfoCard title={experiment.name} className="bg-muted/20 p-5" bodyClassName="text-sm leading-7 text-foreground/72">
            <div class="mb-3">
              <span class="inline-flex items-center rounded-full border border-border/70 bg-background/85 px-2.5 py-1 text-[11px] font-medium uppercase tracking-[0.12em] text-foreground/65">
                {experiment.label}
              </span>
            </div>
            <p>{experiment.summary}</p>
          </InfoCard>
        ))}
      </div>
    </ContentSection>

    <ContentSection title="What these projects have in common" className="mb-0">
      <InfoCard className="bg-background/60">
        <p class="text-base leading-8 text-foreground/80">
          They all sit somewhere near the same center of gravity: systems thinking, practical automation, architecture that survives reality, and a bias toward useful over flashy.
        </p>
      </InfoCard>
    </ContentSection>
  </main>
  <Footer />
</Layout>
