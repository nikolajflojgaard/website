---
import Footer from "@/components/Footer.astro";
import Header from "@/components/Header.astro";
import { SITE } from "@/config";
import Layout from "@/layouts/Layout.astro";
import Main from "@/layouts/Main.astro";

const principles = [
  "Useful beats impressive.",
  "Systems beat one-off hacks.",
  "Clarity beats fluff.",
  "Shipping beats endless planning.",
  "Good taste matters.",
  "AI is only valuable when it survives real workflows.",
];

const capabilities = [
  "Shape product ideas into sharper, more buildable directions.",
  "Write and edit with a more human, less synthetic cadence.",
  "Build and ship changes across code, content, and automation systems.",
  "Structure workflows, task routing, and operational glue.",
  "Connect systems and reduce the kind of chaos that grows between teams, tools, and abstractions.",
];

const limits = [
  "Not a replacement for deep domain ownership.",
  "Not magic when the underlying system is messy and nobody wants to decide.",
  "Not a substitute for real taste if nobody curates the output.",
  "Less useful when goals stay vague on purpose.",
];
---

<Layout title={`Working With Jason | ${SITE.title}`} description={`How ${SITE.title} works with Jason across systems, writing, product thinking, and delivery.`}>
  <Header />
  <Main
    pageTitle="Working With Jason"
    pageDesc="A practical collaboration model, not AI fan fiction."
  >
    <section class="mb-8 rounded-xl border border-border bg-muted/30 p-6">
      <p class="mb-4 text-base leading-8">
        Jason is an AI assistant shaped into a personal developer. The useful version of that is not “ask a chatbot things.” It is having a system that can think across writing, product direction, architecture, workflows, and execution without losing the thread every five minutes.
      </p>
      <p class="text-base leading-8">
        The point is not novelty. The point is leverage. Better judgment, faster iteration, fewer sloppy handoffs, and more useful output.
      </p>
    </section>

    <section class="mb-8 grid gap-4 md:grid-cols-2">
      <div class="rounded-xl border border-border bg-background p-5">
        <h2 class="mb-3 text-lg font-semibold">How Jason thinks</h2>
        <ul class="list-disc space-y-1 pl-5 text-sm leading-7">
          {principles.map((item) => <li>{item}</li>)}
        </ul>
      </div>
      <div class="rounded-xl border border-border bg-background p-5">
        <h2 class="mb-3 text-lg font-semibold">What Jason can do</h2>
        <ul class="list-disc space-y-1 pl-5 text-sm leading-7">
          {capabilities.map((item) => <li>{item}</li>)}
        </ul>
      </div>
    </section>

    <section class="mb-8 rounded-xl border border-border bg-background p-6">
      <h2 class="mb-3 text-lg font-semibold">What we have built together</h2>
      <p class="mb-4 text-sm leading-7 opacity-85">
        The assistant is only interesting when it connects to actual output. So far that includes work like Household Chores, Home Brief, this website itself, workflow and memory systems, and a broader set of automation and integration experiments.
      </p>
      <div class="flex flex-wrap gap-3">
        <a href="/projects" class="inline-flex rounded-md border border-border px-4 py-2 text-sm font-medium hover:text-accent">See projects</a>
        <a href="/resume" class="inline-flex rounded-md border border-border px-4 py-2 text-sm font-medium hover:text-accent">See work</a>
      </div>
    </section>

    <section class="rounded-xl border border-border bg-background p-6">
      <h2 class="mb-3 text-lg font-semibold">Where Jason is less useful</h2>
      <ul class="list-disc space-y-1 pl-5 text-sm leading-7">
        {limits.map((item) => <li>{item}</li>)}
      </ul>
    </section>
  </Main>
  <Footer />
</Layout>
