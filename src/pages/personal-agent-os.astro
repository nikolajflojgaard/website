---
import Footer from "@/components/Footer.astro";
import Header from "@/components/Header.astro";
import { SITE } from "@/config";
import Layout from "@/layouts/Layout.astro";

const runtimeStatus = [
  { label: "Gateway", value: "running", detail: "local message bridge active" },
  { label: "OpenClaw node", value: "loaded", detail: "node service registered" },
  { label: "Personal ops", value: "active", detail: "dashboard generator online" },
  { label: "Telegram", value: "configured", detail: "direct channel available" },
  { label: "Cron", value: "12 jobs", detail: "scheduler enabled" },
  { label: "Exposure", value: "private", detail: "no public tunnel shown" },
];

const stack = [
  ["Agent Workbench", "Scopes messy requests into lanes, briefs, gates, and reports."],
  ["TaskFlow Runner", "Keeps long-running work alive across waits and resumes."],
  ["QA / Red Team", "Reviews bugs, privacy risk, weak validation, and overclaims."],
  ["Memory Distiller", "Promotes useful lessons without dumping raw history."],
  ["Evaluation Harness", "Scores behavior changes with fixtures and rubrics."],
  ["Code Doc Pipeline", "Keeps code, docs, and diagrams from drifting apart."],
  ["Personal Ops Dashboard", "Shows local runtime health behind private access."],
  ["Skill Publisher", "Packages reusable skills with release gates."],
];

const cronGroups = [
  ["Morning briefs", "3 jobs", "daily preflight, home brief, final brief"],
  ["Household monitors", "2 jobs", "Drive sweep and EV-drive checks"],
  ["Backups", "2 jobs", "workspace and Home Assistant config"],
  ["Alerts", "3 jobs", "watch checks and stock buy-zone alerts"],
];

const identity = [
  ["User", "Nikolaj", "owner context"],
  ["Agent", "Jason", "personal developer"],
  ["Soul", "engineering-minded", "blunt, useful, privacy-aware"],
  ["Memory", "layered", "daily notes plus curated long-term memory"],
];
---

<Layout
  title={`Personal Agent OS | ${SITE.title}`}
  description="A simple public status page for the personal agent operating system behind Jason."
>
  <Header />
  <main id="main-content" class="w-full pb-16">
    <section class="mx-auto grid w-full max-w-6xl gap-8 px-4 pt-8 pb-10 lg:grid-cols-[0.76fr_1.24fr] lg:items-end">
      <div>
        <p class="eyebrow">Personal Agent OS</p>
        <h1 class="mt-4 text-4xl font-semibold tracking-tight text-foreground sm:text-5xl">
          The hidden dashboard behind Jason.
        </h1>
        <p class="mt-5 max-w-2xl text-base leading-8 text-foreground/78">
          A compact public-safe view of the agent system: what is running, what has shipped, and what context is
          loaded. No private prompts, chat IDs, local addresses, or raw memory.
        </p>
      </div>

      <div class="status-strip" aria-label="Agent OS headline status">
        <article>
          <strong>online</strong>
          <span>runtime</span>
        </article>
        <article>
          <strong>8</strong>
          <span>stack parts</span>
        </article>
        <article>
          <strong>12</strong>
          <span>cron jobs</span>
        </article>
        <article>
          <strong>private</strong>
          <span>ops layer</span>
        </article>
      </div>
    </section>

    <section class="border-y border-border bg-background">
      <div class="mx-auto max-w-6xl px-4 py-12">
        <div class="section-head">
          <div>
            <p class="eyebrow">Runtime</p>
            <h2>What is running</h2>
          </div>
          <p>Snapshot refreshed 26 Jun 2026, 06:50 CPH.</p>
        </div>

        <div class="runtime-grid">
          {runtimeStatus.map((item) => (
            <article class="runtime-card">
              <span>{item.value}</span>
              <h3>{item.label}</h3>
              <p>{item.detail}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="mx-auto grid max-w-6xl gap-8 px-4 py-12 lg:grid-cols-[1fr_1fr]">
      <div>
        <div class="section-head compact">
          <div>
            <p class="eyebrow">Stack</p>
            <h2>Shipped parts</h2>
          </div>
        </div>

        <div class="list-panel">
          {stack.map(([name, detail]) => (
            <article>
              <h3>{name}</h3>
              <p>{detail}</p>
            </article>
          ))}
        </div>
      </div>

      <div>
        <div class="section-head compact">
          <div>
            <p class="eyebrow">Cron</p>
            <h2>Scheduled work</h2>
          </div>
        </div>

        <div class="list-panel">
          {cronGroups.map(([name, count, detail]) => (
            <article class="split-row">
              <div>
                <h3>{name}</h3>
                <p>{detail}</p>
              </div>
              <strong>{count}</strong>
            </article>
          ))}
        </div>

        <div class="identity-panel">
          <div class="section-head compact">
            <div>
              <p class="eyebrow">Identity</p>
              <h2>User, soul, memory</h2>
            </div>
          </div>

          <div class="identity-grid">
            {identity.map(([label, value, detail]) => (
              <article>
                <span>{label}</span>
                <h3>{value}</h3>
                <p>{detail}</p>
              </article>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section class="border-y border-border bg-muted/18">
      <div class="mx-auto grid max-w-6xl gap-6 px-4 py-10 lg:grid-cols-[0.85fr_1.15fr]">
        <div>
          <p class="eyebrow">KISS rule</p>
          <h2 class="mt-3 text-3xl font-semibold tracking-tight">One page. One job.</h2>
        </div>
        <p class="max-w-3xl text-base leading-8 text-foreground/76">
          This page should prove the operating system exists and is healthy. Deeper logs, live sessions, prompts,
          and memory contents belong in the private cockpit, not on the public website.
        </p>
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<style>
  .eyebrow {
    color: var(--accent);
    font-size: 0.75rem;
    font-weight: 850;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .status-strip,
  .runtime-grid,
  .identity-grid {
    display: grid;
    gap: 0.8rem;
  }

  .status-strip {
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }

  .status-strip article,
  .runtime-card,
  .list-panel,
  .identity-grid article {
    border: 1px solid var(--border);
    border-radius: 8px;
    background: color-mix(in srgb, var(--background) 90%, var(--muted) 10%);
  }

  .status-strip article {
    min-height: 7.5rem;
    padding: 1rem;
  }

  .status-strip strong {
    display: block;
    color: var(--accent);
    font-size: clamp(1.7rem, 4.5vw, 3rem);
    line-height: 1;
  }

  .status-strip span,
  .runtime-card span,
  .identity-grid span {
    display: block;
    margin-top: 0.7rem;
    color: color-mix(in srgb, var(--foreground) 68%, transparent);
    font-size: 0.72rem;
    font-weight: 850;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .section-head {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 1.5rem;
    margin-bottom: 1.5rem;
  }

  .section-head.compact {
    margin-bottom: 1rem;
  }

  .section-head h2 {
    margin: 0.35rem 0 0;
    font-size: 2rem;
    font-weight: 720;
    letter-spacing: 0;
    line-height: 1.2;
  }

  .section-head > p {
    max-width: 22rem;
    color: color-mix(in srgb, var(--foreground) 66%, transparent);
    font-size: 0.92rem;
    line-height: 1.6;
    text-align: right;
  }

  .runtime-grid {
    grid-template-columns: repeat(6, minmax(0, 1fr));
  }

  .runtime-card {
    min-height: 9rem;
    padding: 1rem;
  }

  .runtime-card span {
    display: inline-flex;
    width: fit-content;
    margin-top: 0;
    border: 1px solid color-mix(in srgb, var(--accent) 36%, var(--border));
    border-radius: 999px;
    padding: 0.24rem 0.55rem;
    color: var(--accent);
  }

  .runtime-card h3,
  .list-panel h3,
  .identity-grid h3 {
    margin: 0.85rem 0 0;
    font-size: 1rem;
    font-weight: 760;
    line-height: 1.3;
  }

  .runtime-card p,
  .list-panel p,
  .identity-grid p {
    margin: 0.45rem 0 0;
    color: color-mix(in srgb, var(--foreground) 68%, transparent);
    font-size: 0.9rem;
    line-height: 1.6;
  }

  .list-panel article {
    border-top: 1px solid var(--border);
    padding: 1rem;
  }

  .list-panel article:first-child {
    border-top: 0;
  }

  .list-panel h3 {
    margin-top: 0;
  }

  .split-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 1rem;
    align-items: center;
  }

  .split-row strong {
    color: var(--accent);
    font-size: 0.82rem;
    font-weight: 850;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .identity-panel {
    margin-top: 2rem;
  }

  .identity-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .identity-grid article {
    min-height: 8rem;
    padding: 1rem;
  }

  .identity-grid h3 {
    margin-top: 0.45rem;
  }

  @media (max-width: 1120px) {
    .runtime-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (max-width: 760px) {
    .section-head {
      display: block;
    }

    .section-head > p {
      margin-top: 0.75rem;
      text-align: left;
    }

    .status-strip,
    .runtime-grid,
    .identity-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 520px) {
    .status-strip,
    .runtime-grid,
    .identity-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
