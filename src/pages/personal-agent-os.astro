---
import Footer from "@/components/Footer.astro";
import Header from "@/components/Header.astro";
import { SITE } from "@/config";
import Layout from "@/layouts/Layout.astro";

const headlineMetrics = [
  {
    value: "8",
    label: "public repos",
    detail: "agent stack components shipped as reusable projects",
  },
  { value: "6", label: "control loops", detail: "shape, run, review, measure, remember, publish" },
  {
    value: "8/8",
    label: "core docs",
    detail: "core repos covered by generated docs or CI drift checks",
  },
  { value: "30 min", label: "heartbeat", detail: "proactive operating rhythm for useful checks" },
];

const operatingScore = [
  {
    label: "Work shaping",
    value: 100,
    note: "Agent Workbench creates scope, lanes, briefs, gates, and reports.",
  },
  {
    label: "Durable execution",
    value: 92,
    note: "TaskFlow handles waits, child tasks, approvals, resumes, and final states.",
  },
  {
    label: "Quality review",
    value: 86,
    note: "QA / Red Team catches bugs, privacy risk, overclaims, and weak validation.",
  },
  {
    label: "Memory hygiene",
    value: 82,
    note: "Daily notes are separated from compact long-term memory.",
  },
  {
    label: "Evaluation",
    value: 76,
    note: "Fixtures and rubrics exist; deeper regression coverage is the next lift.",
  },
  {
    label: "Publishing",
    value: 72,
    note: "Skill packaging is built; community publishing stays gated until auth is ready.",
  },
];

const systemRows = [
  {
    area: "Execution",
    signal: "Can the agent keep real work alive across waits?",
    current: "TaskFlow runner shipped",
    verdict: "strong",
  },
  {
    area: "Quality",
    signal: "Are claims reviewed before public updates?",
    current: "Read-only QA roles shipped",
    verdict: "strong",
  },
  {
    area: "Memory",
    signal: "Does useful context survive without dumping everything?",
    current: "Distillation workflow active",
    verdict: "good",
  },
  {
    area: "Measurement",
    signal: "Can behavior improvements be scored instead of guessed?",
    current: "Evaluation harness shipped",
    verdict: "growing",
  },
  {
    area: "Release",
    signal: "Can skills be packaged safely for reuse?",
    current: "Publisher pipeline shipped",
    verdict: "gated",
  },
];

const components = [
  {
    name: "Agent Workbench",
    value: "Turns vague asks into scoped work packets.",
    status: "live",
    href: "https://github.com/nikolajflojgaard/agent-workbench",
  },
  {
    name: "TaskFlow Agent Runner",
    value: "Keeps long-running jobs from dying in chat history.",
    status: "live",
    href: "https://github.com/nikolajflojgaard/taskflow-agent-runner",
  },
  {
    name: "Agent QA / Red Team",
    value: "Adds a second pass for bugs, overclaims, privacy, and release risk.",
    status: "live",
    href: "https://github.com/nikolajflojgaard/agent-qa-red-team",
  },
  {
    name: "Agent Memory Distiller",
    value: "Promotes durable lessons while leaving noisy logs behind.",
    status: "live",
    href: "https://github.com/nikolajflojgaard/agent-memory-distiller",
  },
  {
    name: "Agent Evaluation Harness",
    value: "Scores behavior against fixtures, rubrics, and regression checks.",
    status: "live",
    href: "https://github.com/nikolajflojgaard/agent-evaluation-harness",
  },
  {
    name: "Code Doc Pipeline",
    value: "Keeps architecture docs and diagrams from drifting away from code.",
    status: "live",
    href: "https://github.com/nikolajflojgaard/code-doc-pipeline",
  },
  {
    name: "Personal Ops Dashboard",
    value: "Local command center for runtime health and operational attention.",
    status: "private",
    href: "https://github.com/nikolajflojgaard/personal-ops-dashboard",
  },
  {
    name: "Skill Publisher Pipeline",
    value: "Packages reusable skills with reports, release notes, and gates.",
    status: "gated",
    href: "https://github.com/nikolajflojgaard/skill-publisher-pipeline",
  },
];

const nextMoves = [
  [
    "Remote cockpit",
    "Add Cloudflare Access or Tailscale before any live operational dashboard goes online.",
  ],
  [
    "Regression suite",
    "Run recurring eval fixtures so behavior changes show up as evidence, not impressions.",
  ],
  ["Skill distribution", "Finish the publishing gate once ClawHub/community auth is ready."],
  [
    "Portfolio view",
    "Expose public metrics for shipped repos, docs health, deploys, and roadmap state.",
  ],
];
---

<Layout
  title={`Personal Agent OS | ${SITE.title}`}
  description="A public metrics view of a personal agent operating system: shipped components, control loops, validation, maturity, and next bottlenecks."
>
  <Header />
  <main id="main-content" class="w-full pb-16">
    <section class="mx-auto w-full max-w-6xl px-4 pt-8 pb-10">
      <div class="grid gap-8 lg:grid-cols-[0.82fr_1.18fr] lg:items-end">
        <div>
          <p class="text-sm font-semibold uppercase tracking-[0.16em] text-accent">Personal Agent OS</p>
          <h1 class="mt-4 text-4xl font-semibold tracking-tight text-foreground sm:text-5xl">
            A metrics dashboard for the agent stack behind Jason.
          </h1>
          <p class="mt-5 max-w-2xl text-base leading-8 text-foreground/78">
            This view tracks what matters: what has shipped, which control loops are covered, where the system is
            mature, and what still blocks the jump from personal automation to a reusable agent operating model.
          </p>
        </div>

        <div class="metric-board" aria-label="Personal Agent OS metrics">
          {headlineMetrics.map((metric) => (
            <article class="metric-card">
              <strong>{metric.value}</strong>
              <span>{metric.label}</span>
              <p>{metric.detail}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="border-y border-border bg-background">
      <div class="mx-auto grid max-w-6xl gap-8 px-4 py-12 lg:grid-cols-[0.74fr_1.26fr]">
        <div>
          <p class="text-sm font-semibold uppercase tracking-[0.16em] text-accent">Operating score</p>
          <h2 class="mt-3 text-3xl font-semibold tracking-tight">How complete the system is</h2>
          <p class="mt-4 text-base leading-8 text-foreground/76">
            The useful question is not whether the assistant can chat. It is whether the operating loops around it
            are strong enough to ship work, catch mistakes, remember context, and improve over time.
          </p>
        </div>

        <div class="score-stack">
          {operatingScore.map((item) => (
            <article class="score-row">
              <div class="score-copy">
                <div>
                  <h3>{item.label}</h3>
                  <span>{item.value}%</span>
                </div>
                <p>{item.note}</p>
              </div>
              <div class="score-track" aria-label={`${item.label} ${item.value}%`}>
                <span style={`width: ${item.value}%`}></span>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="mx-auto max-w-6xl px-4 py-12">
      <div class="grid gap-8 lg:grid-cols-[1.05fr_0.95fr]">
        <div>
          <p class="text-sm font-semibold uppercase tracking-[0.16em] text-accent">Signal table</p>
          <h2 class="mt-3 text-3xl font-semibold tracking-tight">What is valuable to know</h2>
          <div class="signal-table" aria-label="Agent system signals">
            <div class="signal-row signal-head">
              <span>Area</span>
              <span>Question</span>
              <span>Current</span>
              <span>State</span>
            </div>
            {systemRows.map((row) => (
              <div class="signal-row">
                <strong>{row.area}</strong>
                <p>{row.signal}</p>
                <p>{row.current}</p>
                <span>{row.verdict}</span>
              </div>
            ))}
          </div>
        </div>

        <aside class="next-panel">
          <p class="eyebrow">Next bottlenecks</p>
          <h2>Where attention should go next</h2>
          <div class="next-list">
            {nextMoves.map(([title, body]) => (
              <article>
                <h3>{title}</h3>
                <p>{body}</p>
              </article>
            ))}
          </div>
        </aside>
      </div>
    </section>

    <section class="border-y border-border bg-muted/18">
      <div class="mx-auto max-w-6xl px-4 py-12">
        <div class="max-w-3xl">
          <p class="text-sm font-semibold uppercase tracking-[0.16em] text-accent">Component map</p>
          <h2 class="mt-3 text-3xl font-semibold tracking-tight">The stack, shown as product surface</h2>
          <p class="mt-4 text-base leading-8 text-foreground/76">
            The public page should show capability and momentum. The operational details stay behind the curtain;
            the public value is the pattern, the shipped modules, and the evidence that the system is getting better.
          </p>
        </div>

        <div class="component-grid">
          {components.map((component) => (
            <article class="component-card">
              <div>
                <span>{component.status}</span>
                <h3>{component.name}</h3>
              </div>
              <p>{component.value}</p>
              <a href={component.href}>View repo</a>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="mx-auto grid max-w-6xl gap-8 px-4 py-12 lg:grid-cols-[0.8fr_1.2fr]">
      <div>
        <p class="text-sm font-semibold uppercase tracking-[0.16em] text-accent">Access model</p>
        <h2 class="mt-3 text-3xl font-semibold tracking-tight">Public metrics. Private operations.</h2>
      </div>
      <div class="space-y-4 text-base leading-8 text-foreground/76">
        <p>
          This page should be useful to visitors without exposing local state. It can show the scorecard, shipped
          modules, validation coverage, and roadmap pressure.
        </p>
        <p>
          The real command center belongs behind a hard access layer. Cloudflare Access or Tailscale is the right
          move before any live runtime dashboard becomes remotely reachable.
        </p>
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<style>
  .metric-board {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem;
  }

  .metric-card,
  .score-row,
  .next-panel,
  .component-card,
  .signal-table {
    border: 1px solid var(--border);
    border-radius: 8px;
    background: color-mix(in srgb, var(--background) 88%, var(--muted) 12%);
  }

  .metric-card {
    min-height: 9rem;
    padding: 1rem;
  }

  .metric-card strong {
    display: block;
    color: var(--accent);
    font-size: clamp(2rem, 6vw, 3.35rem);
    line-height: 1;
  }

  .metric-card span,
  .eyebrow,
  .component-card span {
    display: block;
    margin-top: 0.7rem;
    color: color-mix(in srgb, var(--foreground) 78%, transparent);
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .metric-card p,
  .score-copy p,
  .next-list p,
  .component-card p,
  .signal-row p {
    margin: 0.55rem 0 0;
    color: color-mix(in srgb, var(--foreground) 70%, transparent);
    font-size: 0.92rem;
    line-height: 1.65;
  }

  .score-stack {
    display: grid;
    gap: 0.85rem;
  }

  .score-row {
    padding: 1rem;
  }

  .score-copy > div {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
  }

  .score-copy h3,
  .next-panel h2,
  .next-list h3,
  .component-card h3 {
    margin: 0;
    font-weight: 750;
  }

  .score-copy span {
    color: var(--accent);
    font-weight: 800;
  }

  .score-track {
    height: 0.55rem;
    margin-top: 0.9rem;
    overflow: hidden;
    border-radius: 999px;
    background: color-mix(in srgb, var(--muted) 45%, var(--background));
  }

  .score-track span {
    display: block;
    height: 100%;
    border-radius: inherit;
    background: linear-gradient(90deg, var(--accent), color-mix(in srgb, var(--accent) 54%, var(--foreground)));
  }

  .signal-table {
    margin-top: 1.5rem;
    overflow: hidden;
  }

  .signal-row {
    display: grid;
    grid-template-columns: minmax(6.5rem, 0.55fr) minmax(0, 1.25fr) minmax(0, 0.95fr) minmax(4.5rem, 0.35fr);
    gap: 1rem;
    align-items: center;
    border-top: 1px solid var(--border);
    padding: 0.95rem 1rem;
  }

  .signal-row:first-child {
    border-top: 0;
  }

  .signal-head {
    background: color-mix(in srgb, var(--muted) 28%, var(--background));
    color: color-mix(in srgb, var(--foreground) 64%, transparent);
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .signal-row > span:last-child {
    color: var(--accent);
    font-size: 0.78rem;
    font-weight: 800;
    text-transform: uppercase;
  }

  .next-panel {
    padding: 1.25rem;
  }

  .next-panel h2 {
    margin-top: 0.45rem;
    font-size: 1.7rem;
    line-height: 1.2;
  }

  .next-list {
    display: grid;
    gap: 0.9rem;
    margin-top: 1.25rem;
  }

  .next-list article {
    border-top: 1px solid var(--border);
    padding-top: 0.9rem;
  }

  .component-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0.9rem;
    margin-top: 2rem;
  }

  .component-card {
    display: flex;
    min-height: 13rem;
    flex-direction: column;
    justify-content: space-between;
    padding: 1rem;
  }

  .component-card span {
    margin-top: 0;
    color: var(--accent);
  }

  .component-card h3 {
    margin-top: 0.45rem;
    font-size: 1.06rem;
    line-height: 1.3;
  }

  .component-card a {
    margin-top: 1rem;
    color: color-mix(in srgb, var(--foreground) 78%, transparent);
    font-size: 0.88rem;
    font-weight: 800;
  }

  .component-card a:hover {
    color: var(--accent);
  }

  @media (max-width: 960px) {
    .component-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .signal-row {
      grid-template-columns: 1fr;
      gap: 0.35rem;
    }
  }

  @media (max-width: 640px) {
    .metric-board,
    .component-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
