---
import Footer from "@/components/Footer.astro";
import Header from "@/components/Header.astro";
import { SITE } from "@/config";
import Layout from "@/layouts/Layout.astro";

const runtimeRows = [
  ["Gateway", "running", "Message bridge is active."],
  ["OpenClaw node", "running", "Local node service is registered."],
  ["Personal ops", "running", "Dashboard generator is active."],
  ["Telegram", "configured", "Direct chat surface is available."],
  ["Scheduler", "enabled", "12 cron jobs tracked."],
  ["Exposure", "private", "No public tunnel or raw ops endpoint shown."],
];

const cronRows = [
  ["Briefs", "3", "daily preflight, home brief, daily brief"],
  ["Monitoring", "4", "Drive, EV, watch, household checks"],
  ["Backups", "2", "workspace and Home Assistant config"],
  ["Market alerts", "3", "stock/watchlist checks"],
];

const identityRows = [
  ["User", "Nikolaj", "owner context"],
  ["Agent", "Jason", "personal developer"],
  ["Soul", "engineering-minded", "blunt, useful, privacy-aware"],
  ["Memory", "layered", "daily notes plus curated long-term memory"],
];
---

<Layout
  title={`Personal Agent OS | ${SITE.title}`}
  description="A small public-safe status page for Jason's personal agent operating layer."
>
  <Header />
  <main id="main-content" class="w-full pb-16">
    <section class="mx-auto w-full max-w-5xl px-4 pt-8 pb-10">
      <p class="eyebrow">Personal Agent OS</p>
      <h1 class="mt-4 max-w-3xl text-4xl font-semibold tracking-tight text-foreground sm:text-5xl">
        Jason runtime status.
      </h1>
      <p class="mt-5 max-w-2xl text-base leading-8 text-foreground/78">
        A public-safe check that the local agent layer exists and is alive. No prompts, chat IDs, local addresses,
        hostnames, raw memory, or session logs.
      </p>
      <p class="snapshot">Snapshot: 26 Jun 2026, 07:10 CPH</p>
    </section>

    <section class="border-y border-border bg-background">
      <div class="mx-auto grid max-w-5xl gap-8 px-4 py-10 lg:grid-cols-[1fr_0.82fr]">
        <article class="panel">
          <div class="panel-head">
            <p class="eyebrow">Runtime</p>
            <strong>alive</strong>
          </div>

          <div class="status-table" aria-label="Agent runtime status">
            {runtimeRows.map(([name, state, detail]) => (
              <div class="status-row">
                <h2>{name}</h2>
                <span>{state}</span>
                <p>{detail}</p>
              </div>
            ))}
          </div>
        </article>

        <article class="panel">
          <div class="panel-head">
            <p class="eyebrow">Cron</p>
            <strong>12 jobs</strong>
          </div>

          <div class="status-table compact" aria-label="Scheduled automation groups">
            {cronRows.map(([group, count, detail]) => (
              <div class="status-row">
                <h2>{group}</h2>
                <span>{count}</span>
                <p>{detail}</p>
              </div>
            ))}
          </div>
        </article>
      </div>
    </section>

    <section class="mx-auto max-w-5xl px-4 py-10">
      <article class="panel">
        <div class="panel-head">
          <p class="eyebrow">Identity and memory</p>
          <strong>loaded</strong>
        </div>

        <div class="identity-grid">
          {identityRows.map(([label, value, detail]) => (
            <div>
              <span>{label}</span>
              <h2>{value}</h2>
              <p>{detail}</p>
            </div>
          ))}
        </div>
      </article>
    </section>
  </main>
  <Footer />
</Layout>

<style>
  .eyebrow {
    color: var(--accent);
    font-size: 0.75rem;
    font-weight: 850;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .snapshot {
    margin-top: 1.5rem;
    color: color-mix(in srgb, var(--foreground) 66%, transparent);
    font-size: 0.88rem;
    font-weight: 750;
  }

  .panel {
    border: 1px solid var(--border);
    border-radius: 8px;
    background: color-mix(in srgb, var(--background) 91%, var(--muted) 9%);
  }

  .panel-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    border-bottom: 1px solid var(--border);
    padding: 1rem;
  }

  .panel-head strong,
  .status-row span {
    color: var(--accent);
    font-size: 0.78rem;
    font-weight: 850;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .status-table {
    display: grid;
  }

  .status-row {
    display: grid;
    grid-template-columns: minmax(8rem, 0.72fr) minmax(5.5rem, 0.28fr) minmax(0, 1fr);
    gap: 1rem;
    align-items: baseline;
    border-top: 1px solid var(--border);
    padding: 1rem;
  }

  .panel-head + .status-table .status-row:first-child {
    border-top: 0;
  }

  .status-table.compact .status-row {
    grid-template-columns: minmax(7rem, 1fr) auto;
  }

  .status-table.compact .status-row p {
    grid-column: 1 / -1;
  }

  .status-row h2,
  .identity-grid h2 {
    margin: 0;
    font-size: 1rem;
    font-weight: 760;
    line-height: 1.35;
  }

  .status-row p,
  .identity-grid p {
    margin: 0;
    color: color-mix(in srgb, var(--foreground) 68%, transparent);
    font-size: 0.92rem;
    line-height: 1.6;
  }

  .identity-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }

  .identity-grid div {
    border-left: 1px solid var(--border);
    padding: 1rem;
  }

  .identity-grid div:first-child {
    border-left: 0;
  }

  .identity-grid span {
    display: block;
    margin-bottom: 0.45rem;
    color: color-mix(in srgb, var(--foreground) 62%, transparent);
    font-size: 0.72rem;
    font-weight: 850;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .identity-grid p {
    margin-top: 0.45rem;
  }

  @media (max-width: 760px) {
    .status-row,
    .status-table.compact .status-row {
      grid-template-columns: 1fr;
      gap: 0.35rem;
    }

    .status-table.compact .status-row p {
      grid-column: auto;
    }

    .identity-grid {
      grid-template-columns: 1fr;
    }

    .identity-grid div {
      border-top: 1px solid var(--border);
      border-left: 0;
    }

    .identity-grid div:first-child {
      border-top: 0;
    }
  }
</style>
