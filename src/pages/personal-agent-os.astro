---
import Footer from "@/components/Footer.astro";
import Header from "@/components/Header.astro";
import { SITE } from "@/config";
import Layout from "@/layouts/Layout.astro";

const tabs = [
  ["runtime", "Runtime", "Gateway, node, Telegram"],
  ["orchestration", "Orchestration", "Flows currently worth showing"],
  ["control", "Control Deck", "Approvals, boundaries, recovery"],
  ["schedules", "Schedules", "Cron and recurring work"],
  ["skills", "Skills", "Enabled tools and auth checks"],
  ["memory", "Memory", "Daily notes and durable recall"],
  ["review", "Review", "QA gates and deploy checks"],
];

const runtimeRows = [
  {
    label: "Gateway",
    value: "healthy",
    tone: "ok",
    detail: "Message bridge is active.",
  },
  {
    label: "OpenClaw node",
    value: "healthy",
    tone: "ok",
    detail: "Local node service is registered.",
  },
  {
    label: "Personal ops",
    value: "healthy",
    tone: "ok",
    detail: "Dashboard generator is active.",
  },
  {
    label: "Telegram",
    value: "healthy",
    tone: "ok",
    detail: "Direct chat surface is available.",
  },
  {
    label: "Scheduler",
    value: "watch",
    tone: "warning",
    detail: "Recurring work is tracked through Gateway cron.",
  },
  {
    label: "Exposure",
    value: "private",
    tone: "ok",
    detail: "No public tunnel or raw ops endpoint shown.",
  },
];

const approvalQueue = [
  {
    command: "sync site content",
    scope: "content workspace only",
    status: "ready",
    tone: "ok",
  },
  {
    command: "run deploy check",
    scope: "build + validation gates",
    status: "pending approval",
    tone: "warning",
  },
  {
    command: "restart host services",
    scope: "local privileged action",
    status: "blocked",
    tone: "danger",
  },
];

const trustBoundaries = [
  {
    zone: "Public web",
    role: "status-level cockpit only",
    direction: "read",
  },
  {
    zone: "Agent workspace",
    role: "tools, plans, and sanitized state",
    direction: "guarded",
  },
  {
    zone: "Private services",
    role: "auth-bound integrations and local automation",
    direction: "isolated",
  },
];

const recoveryLadder = [
  "Retry idempotent step",
  "Fallback to safe default path",
  "Request explicit user approval",
  "Escalate to manual recovery runbook",
];

const validationTimeline = [
  {
    time: "08:12",
    event: "Lint + static checks passed",
    tone: "ok",
  },
  {
    time: "08:20",
    event: "Build completed with sanitized output",
    tone: "ok",
  },
  {
    time: "08:24",
    event: "Public-safety gate confirmed",
    tone: "warning",
  },
  {
    time: "08:29",
    event: "Deploy ready and awaiting publish",
    tone: "ok",
  },
];

const orchestrationFlows = [
  {
    name: "Daily brief pipeline",
    state: "live",
    tone: "ok",
    owner: "Cron -> Jason -> Telegram",
    path: ["preflight", "generate", "publish"],
    detail:
      "Morning brief jobs run as isolated scheduled work, then deliver the useful summary back to Telegram.",
  },
  {
    name: "Repo publish lane",
    state: "live",
    tone: "ok",
    owner: "Jason -> GitHub Actions -> Simply",
    path: ["pull", "validate", "deploy"],
    detail:
      "Site changes use the shared-main publish rule: rebase, build, commit, push, then watch deployment.",
  },
  {
    name: "TaskFlow runner",
    state: "ready",
    tone: "warning",
    owner: "TaskFlow -> child agents",
    path: ["brief", "wait", "resume"],
    detail:
      "Long-running work can be split into durable child tasks with wait states, gates, and final reports.",
  },
];

const scheduleRows = [
  {
    label: "Daily brief",
    value: "healthy",
    tone: "ok",
    detail: "Preflight, home brief, and final morning brief delivery.",
  },
  {
    label: "Drive and EV checks",
    value: "watch",
    tone: "warning",
    detail: "Recurring monitoring work is isolated from the main chat.",
  },
  {
    label: "Backups",
    value: "healthy",
    tone: "ok",
    detail: "Workspace and Home Assistant config backup jobs stay separate from ad hoc work.",
  },
  {
    label: "Market alerts",
    value: "healthy",
    tone: "ok",
    detail: "Stock/watchlist checks run on a fixed cadence.",
  },
];

const memoryRows = [
  {
    label: "Daily notes",
    value: "healthy",
    tone: "ok",
    detail: "Raw session context lands in dated notes when it is worth keeping.",
  },
  {
    label: "Long-term memory",
    value: "healthy",
    tone: "ok",
    detail: "Durable facts and preferences stay compact in MEMORY.md.",
  },
  {
    label: "Memory drift",
    value: "watch",
    tone: "warning",
    detail: "Raw notes should be distilled when durable signal starts accumulating.",
  },
  {
    label: "Soul and user",
    value: "healthy",
    tone: "ok",
    detail: "Operating style and owner context are part of the workspace.",
  },
];

const skillRows = [
  {
    label: "Gog OAuth",
    value: "watch",
    tone: "warning",
    detail:
      "Google Workspace auth can expire and should move yellow before Gmail, Calendar, Drive, or Docs fail.",
  },
  {
    label: "GitHub CLI",
    value: "healthy",
    tone: "ok",
    detail: "Repo, CI, deploy, issue, and PR checks depend on authenticated gh access.",
  },
  {
    label: "Home Assistant MCP",
    value: "healthy",
    tone: "ok",
    detail: "Home state, chores, solar, and device checks stay behind local auth.",
  },
  {
    label: "Skill Workshop",
    value: "healthy",
    tone: "ok",
    detail: "Reusable playbooks and durable skill proposals can be inspected before approval.",
  },
  {
    label: "Host restart",
    value: "armed",
    tone: "ok",
    detail:
      "Restart handle is installed, but still requires explicit confirmation before rebooting the local host.",
  },
  {
    label: "Failure state",
    value: "blocked",
    tone: "danger",
    detail:
      "Reserved for broken auth, missing tools, unavailable services, or checks that need manual repair.",
  },
];

const reviewRows = [
  {
    label: "QA / Red Team",
    value: "healthy",
    tone: "ok",
    detail: "Read-only second pass for bugs, weak validation, privacy issues, and overclaims.",
  },
  {
    label: "Deploy watch",
    value: "healthy",
    tone: "ok",
    detail: "GitHub deploy jobs are watched until the final status is known.",
  },
  {
    label: "Public safety",
    value: "gated",
    tone: "warning",
    detail: "The page shows status-level facts only, not private operational contents.",
  },
  {
    label: "Blocked claim",
    value: "blocked",
    tone: "danger",
    detail: "Public claims stop when validation, privacy checks, or source confidence fail.",
  },
];

const identityRows = [
  ["User", "Nikolaj"],
  ["Agent", "Jason"],
  ["Soul", "engineering-minded"],
  ["Memory", "layered"],
];
---

<Layout
  title={`Personal Agent OS | ${SITE.title}`}
  description="A public-safe cockpit for Jason's personal agent operating layer."
>
  <Header />
  <main id="main-content" class="w-full pb-16">
    <section class="site-shell pt-8 pb-8">
      <p class="eyebrow">Personal Agent OS</p>
      <h1 class="mt-4 max-w-3xl text-4xl font-semibold tracking-tight text-foreground sm:text-5xl">
        Agent ops cockpit.
      </h1>
      <p class="mt-5 max-w-2xl text-base leading-8 text-foreground/78">
        A public-safe collaboration-style view of the local agent layer: runtime status, orchestration flows,
        schedules, memory posture, and review gates. No prompts, chat IDs, hostnames, local addresses, secrets, or
        raw logs.
      </p>
    </section>

    <section class="site-shell">
      <div class="ops-shell" aria-label="Agent OS cockpit">
        <aside class="ops-sidebar" aria-label="Agent OS tabs">
          <div class="team-title">
            <span>NF</span>
            <div>
              <strong>Jason OS</strong>
              <p>private operating layer</p>
            </div>
          </div>

          <div class="tab-list" role="tablist" aria-label="Agent OS views">
            {tabs.map(([id, name, detail]) => (
              <button
                type="button"
                class:list={["tab-button", id === "runtime" && "selected"]}
                data-tab={id}
                aria-controls={`${id}-panel`}
                aria-selected={id === "runtime" ? "true" : "false"}
                role="tab"
              >
                <strong>{name}</strong>
                <span>{detail}</span>
              </button>
            ))}
          </div>
        </aside>

        <section class="ops-main">
          <section
            id="runtime-panel"
            class="tab-panel"
            data-panel="runtime"
            role="tabpanel"
            aria-label="Runtime"
          >
            <div class="panel-topbar">
              <div>
                <p class="eyebrow">Runtime</p>
                <h2>Operating layer health</h2>
              </div>
              <span>Snapshot 26 Jun 2026, 08:50 CPH</span>
            </div>

            <div class="metric-grid">
              {runtimeRows.map((row) => (
                <article class:list={["metric-card", `status-${row.tone}`]}>
                  <span>{row.label}</span>
                  <strong>{row.value}</strong>
                  <p>{row.detail}</p>
                </article>
              ))}
            </div>

          </section>

          <section
            id="orchestration-panel"
            class="tab-panel"
            data-panel="orchestration"
            role="tabpanel"
            aria-label="Orchestration"
            hidden
          >
            <div class="panel-topbar">
              <div>
                <p class="eyebrow">Orchestration</p>
                <h2>Flows running behind Jason</h2>
              </div>
              <span>Snapshot 26 Jun 2026, 08:50 CPH</span>
            </div>

            <div class="flow-feed">
              {orchestrationFlows.map((flow) => (
                <article class:list={["flow-card", `status-${flow.tone}`]}>
                  <div class="flow-head">
                    <div>
                      <h3>{flow.name}</h3>
                      <p>{flow.owner}</p>
                    </div>
                    <span>{flow.state}</span>
                  </div>

                  <div class="flow-path" aria-label={`${flow.name} path`}>
                    {flow.path.map((step) => (
                      <span>{step}</span>
                    ))}
                  </div>

                  <p>{flow.detail}</p>
                </article>
              ))}
            </div>
          </section>

          <section
            id="control-panel"
            class="tab-panel"
            data-panel="control"
            role="tabpanel"
            aria-label="Control Deck"
            hidden
          >
            <div class="panel-topbar">
              <div>
                <p class="eyebrow">Control Deck</p>
                <h2>Public-safe control surfaces</h2>
              </div>
              <span>no raw commands</span>
            </div>

            <section class="showcase-grid" aria-label="Public-safe cockpit showcase">
              <article class="showcase-card">
                <div class="showcase-head">
                  <h3>Command Approval Queue</h3>
                  <p>Only abstract command scopes, never raw command logs.</p>
                </div>
                <ul class="queue-list">
                  {approvalQueue.map((item) => (
                    <li>
                      <strong class:list={[`status-${item.tone}`]}>{item.status}</strong>
                      <span>{item.command}</span>
                      <small>{item.scope}</small>
                    </li>
                  ))}
                </ul>
              </article>

              <article class="showcase-card">
                <div class="showcase-head">
                  <h3>Trust Boundary Map</h3>
                  <p>Data crossing is constrained to policy-safe summaries.</p>
                </div>
                <ul class="boundary-list">
                  {trustBoundaries.map((zone) => (
                    <li>
                      <span>{zone.zone}</span>
                      <strong>{zone.direction}</strong>
                      <p>{zone.role}</p>
                    </li>
                  ))}
                </ul>
              </article>

              <article class="showcase-card">
                <div class="showcase-head">
                  <h3>Recovery Ladder</h3>
                  <p>Escalation path for failures without exposing internals.</p>
                </div>
                <ol class="ladder-list">
                  {recoveryLadder.map((step) => (
                    <li>{step}</li>
                  ))}
                </ol>
              </article>

              <article class="showcase-card">
                <div class="showcase-head">
                  <h3>Deploy & Validation Timeline</h3>
                  <p>Recent milestone checks with non-sensitive labels.</p>
                </div>
                <ul class="timeline-list">
                  {validationTimeline.map((step) => (
                    <li>
                      <span>{step.time}</span>
                      <p>{step.event}</p>
                      <strong class:list={[`status-${step.tone}`]}>{step.tone}</strong>
                    </li>
                  ))}
                </ul>
              </article>
            </section>
          </section>

          <section
            id="schedules-panel"
            class="tab-panel"
            data-panel="schedules"
            role="tabpanel"
            aria-label="Schedules"
            hidden
          >
            <div class="panel-topbar">
              <div>
                <p class="eyebrow">Schedules</p>
                <h2>Cron-backed work</h2>
              </div>
              <span>12 tracked jobs</span>
            </div>

            <div class="row-list">
              {scheduleRows.map((row) => (
                <article class:list={[`status-${row.tone}`]}>
                  <h3>{row.label}</h3>
                  <strong>{row.value}</strong>
                  <p>{row.detail}</p>
                </article>
              ))}
            </div>
          </section>

          <section
            id="skills-panel"
            class="tab-panel"
            data-panel="skills"
            role="tabpanel"
            aria-label="Skills"
            hidden
          >
            <div class="panel-topbar">
              <div>
                <p class="eyebrow">Skills</p>
                <h2>Enabled skill health</h2>
              </div>
              <span>auth-aware status</span>
            </div>

            <div class="skill-health">
              <div class="health-grid">
                {skillRows.map((row) => (
                  <article class:list={["health-card", `status-${row.tone}`]}>
                    <div>
                      <span>{row.label}</span>
                      <strong>{row.value}</strong>
                    </div>
                    <p>{row.detail}</p>
                  </article>
                ))}
              </div>
            </div>
          </section>

          <section
            id="memory-panel"
            class="tab-panel"
            data-panel="memory"
            role="tabpanel"
            aria-label="Memory"
            hidden
          >
            <div class="panel-topbar">
              <div>
                <p class="eyebrow">Memory</p>
                <h2>Recall without raw dumps</h2>
              </div>
              <span>public-safe summary</span>
            </div>

            <div class="row-list">
              {memoryRows.map((row) => (
                <article class:list={[`status-${row.tone}`]}>
                  <h3>{row.label}</h3>
                  <strong>{row.value}</strong>
                  <p>{row.detail}</p>
                </article>
              ))}
            </div>
          </section>

          <section
            id="review-panel"
            class="tab-panel"
            data-panel="review"
            role="tabpanel"
            aria-label="Review"
            hidden
          >
            <div class="panel-topbar">
              <div>
                <p class="eyebrow">Review</p>
                <h2>Gates before public claims</h2>
              </div>
              <span>privacy first</span>
            </div>

            <div class="row-list">
              {reviewRows.map((row) => (
                <article class:list={[`status-${row.tone}`]}>
                  <h3>{row.label}</h3>
                  <strong>{row.value}</strong>
                  <p>{row.detail}</p>
                </article>
              ))}
            </div>
          </section>

          <div class="identity-strip" aria-label="Identity and memory">
            {identityRows.map(([label, value]) => (
              <div>
                <span>{label}</span>
                <strong>{value}</strong>
              </div>
            ))}
          </div>
        </section>
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<script>
  const tabButtons = document.querySelectorAll("[data-tab]");
  const tabPanels = document.querySelectorAll("[data-panel]");

  tabButtons.forEach((button) => {
    button.addEventListener("click", () => {
      const selectedTab = button.getAttribute("data-tab");

      tabButtons.forEach((candidate) => {
        const isSelected = candidate === button;
        candidate.classList.toggle("selected", isSelected);
        candidate.setAttribute("aria-selected", isSelected ? "true" : "false");
      });

      tabPanels.forEach((panel) => {
        panel.toggleAttribute("hidden", panel.getAttribute("data-panel") !== selectedTab);
      });
    });
  });
</script>

<style>
  .eyebrow {
    color: var(--accent);
    font-size: 0.75rem;
    font-weight: 850;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .ops-shell {
    display: grid;
    height: 46rem;
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: color-mix(in srgb, var(--background) 92%, var(--muted) 8%);
    color: var(--foreground);
    grid-template-columns: 13rem minmax(0, 1fr);
  }

  .ops-sidebar {
    grid-column: 1;
    border-right: 1px solid var(--border);
    background: color-mix(in srgb, var(--foreground) 90%, var(--background) 10%);
    padding: 0.8rem;
    overflow: auto;
  }

  .team-title {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    border-bottom: 1px solid color-mix(in srgb, var(--background) 18%, transparent);
    padding-bottom: 0.8rem;
    color: var(--background);
  }

  .team-title > span {
    display: grid;
    width: 2.1rem;
    height: 2.1rem;
    place-items: center;
    border-radius: 7px;
    background: var(--background);
    color: var(--foreground);
    font-weight: 850;
  }

  .team-title strong {
    display: block;
    font-size: 0.95rem;
    line-height: 1.25;
  }

  .team-title p,
  .tab-button span,
  .panel-topbar > span,
  .flow-head p,
  .flow-card > p,
  .metric-card p,
  .row-list p,
  .showcase-head p,
  .queue-list small,
  .timeline-list p {
    margin: 0;
    color: color-mix(in srgb, var(--foreground) 68%, transparent);
    font-size: 0.88rem;
    line-height: 1.55;
  }

  .tab-list {
    display: grid;
    gap: 0.3rem;
    margin-top: 0.85rem;
  }

  .tab-button {
    width: 100%;
    border: 1px solid color-mix(in srgb, var(--background) 10%, transparent);
    border-radius: 6px;
    background: transparent;
    padding: 0.58rem 0.62rem;
    color: color-mix(in srgb, var(--background) 88%, transparent);
    text-align: left;
    cursor: pointer;
  }

  .tab-button:hover,
  .tab-button.selected {
    border-color: color-mix(in srgb, var(--background) 24%, transparent);
    background: var(--background);
    color: var(--foreground);
  }

  .tab-button strong,
  .tab-button span {
    display: block;
  }

  .tab-button strong {
    font-size: 0.89rem;
  }

  .tab-button span {
    margin-top: 0.15rem;
    font-size: 0.74rem;
    line-height: 1.35;
  }

  .ops-sidebar .team-title p,
  .ops-sidebar .tab-button span {
    color: color-mix(in srgb, var(--background) 68%, transparent);
  }

  .ops-sidebar .tab-button.selected span,
  .ops-sidebar .tab-button:hover span {
    color: color-mix(in srgb, var(--foreground) 68%, transparent);
  }

  @media (min-width: 761px) {
    .ops-sidebar .team-title p,
    .ops-sidebar .tab-button span {
      display: none;
    }
  }

  .ops-main {
    grid-column: 2;
    display: grid;
    overflow: hidden;
    min-width: 0;
    background: var(--background);
    grid-template-rows: minmax(0, 1fr) auto;
  }

  .tab-panel[hidden] {
    display: none;
  }

  .tab-panel {
    min-height: 0;
    overflow: auto;
  }

  .panel-topbar {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 1rem;
    border-bottom: 1px solid var(--border);
    padding: 1.25rem 1.5rem;
  }

  .panel-topbar h2 {
    margin: 0.35rem 0 0;
    color: var(--foreground);
    font-size: 1.85rem;
    font-weight: 760;
    letter-spacing: 0;
    line-height: 1.2;
  }

  .panel-topbar > span {
    text-align: right;
  }

  .metric-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.85rem;
    padding: 1rem;
  }

  .showcase-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0.85rem;
    align-items: start;
    padding: 1rem;
  }

  .metric-card,
  .flow-card,
  .row-list article,
  .health-card,
  .showcase-card {
    position: relative;
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: var(--background);
  }

  .metric-card::before,
  .flow-card::before,
  .row-list article::before,
  .health-card::before,
  .showcase-card::before {
    position: absolute;
    inset: 0 auto 0 0;
    width: 0.35rem;
    background: var(--status-color);
    content: "";
  }

  .metric-card {
    min-height: 9rem;
    padding: 1rem;
  }

  .metric-card span,
  .identity-strip span {
    display: block;
    color: color-mix(in srgb, var(--foreground) 62%, transparent);
    font-size: 0.68rem;
    font-weight: 850;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .identity-strip strong {
    display: block;
    margin-top: 0.35rem;
    color: var(--accent);
    font-size: 0.95rem;
    line-height: 1.3;
  }

  .metric-card p {
    margin-top: 0.7rem;
  }

  .showcase-card {
    display: grid;
    gap: 0.75rem;
    min-width: 0;
    padding: 1rem;
  }

  .showcase-head h3 {
    margin: 0;
    color: var(--foreground);
    font-size: 1.02rem;
    font-weight: 780;
    line-height: 1.3;
  }

  .showcase-head p {
    margin-top: 0.35rem;
  }

  .queue-list,
  .boundary-list,
  .ladder-list,
  .timeline-list {
    display: grid;
    gap: 0.6rem;
    margin: 0;
    padding: 0;
    list-style: none;
    min-width: 0;
  }

  .queue-list li,
  .boundary-list li,
  .timeline-list li {
    display: grid;
    gap: 0.25rem 0.55rem;
    min-width: 0;
    padding-bottom: 0.45rem;
    border-bottom: 1px solid var(--border);
  }

  .queue-list li {
    grid-template-columns: auto minmax(10rem, 0.7fr) minmax(0, 1fr);
    align-items: center;
  }

  .queue-list li:last-child,
  .boundary-list li:last-child,
  .timeline-list li:last-child {
    padding-bottom: 0;
    border-bottom: 0;
  }

  .queue-list strong,
  .timeline-list strong {
    display: inline-flex;
    width: fit-content;
    border: 1px solid color-mix(in srgb, var(--status-color) 40%, var(--border));
    border-radius: 999px;
    background: color-mix(in srgb, var(--status-color) 12%, var(--background));
    color: var(--status-color);
    padding: 0.2rem 0.55rem;
    font-size: 0.63rem;
    font-weight: 850;
    letter-spacing: 0.05em;
