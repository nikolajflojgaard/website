---
import Footer from "@/components/Footer.astro";
import Header from "@/components/Header.astro";
import { SITE } from "@/config";
import Layout from "@/layouts/Layout.astro";

const tabs = [
  ["runtime", "Runtime", "Gateway, node, Telegram"],
  ["orchestration", "Orchestration", "Flows currently worth showing"],
  ["schedules", "Schedules", "Cron and recurring work"],
  ["skills", "Skills", "Enabled tools and auth checks"],
  ["memory", "Memory", "Daily notes and durable recall"],
  ["review", "Review", "QA gates and deploy checks"],
];

const runtimeRows = [
  ["Gateway", "running", "Message bridge is active."],
  ["OpenClaw node", "running", "Local node service is registered."],
  ["Personal ops", "running", "Dashboard generator is active."],
  ["Telegram", "configured", "Direct chat surface is available."],
  ["Scheduler", "12 jobs", "Recurring work is tracked through Gateway cron."],
  ["Exposure", "private", "No public tunnel or raw ops endpoint shown."],
];

const orchestrationFlows = [
  {
    name: "Daily brief pipeline",
    state: "live",
    owner: "Cron -> Jason -> Telegram",
    path: ["preflight", "generate", "publish"],
    detail:
      "Morning brief jobs run as isolated scheduled work, then deliver the useful summary back to Telegram.",
  },
  {
    name: "Repo publish lane",
    state: "live",
    owner: "Jason -> GitHub Actions -> Simply",
    path: ["pull", "validate", "deploy"],
    detail:
      "Site changes use the shared-main publish rule: rebase, build, commit, push, then watch deployment.",
  },
  {
    name: "TaskFlow runner",
    state: "ready",
    owner: "TaskFlow -> child agents",
    path: ["brief", "wait", "resume"],
    detail:
      "Long-running work can be split into durable child tasks with wait states, gates, and final reports.",
  },
];

const scheduleRows = [
  ["Daily brief", "07:30", "Preflight, home brief, and final morning brief delivery."],
  ["Drive and EV checks", "daily", "Recurring monitoring work is isolated from the main chat."],
  [
    "Backups",
    "scheduled",
    "Workspace and Home Assistant config backup jobs stay separate from ad hoc work.",
  ],
  ["Market alerts", "weekly", "Stock/watchlist checks run on a fixed cadence."],
];

const memoryRows = [
  ["Daily notes", "capture", "Raw session context lands in dated notes when it is worth keeping."],
  ["Long-term memory", "curated", "Durable facts and preferences stay compact in MEMORY.md."],
  ["Soul and user", "loaded", "Operating style and owner context are part of the workspace."],
];

const skillRows = [
  {
    label: "Gog OAuth",
    value: "watch",
    tone: "warning",
    detail:
      "Google Workspace auth can expire and should move yellow before Gmail, Calendar, Drive, or Docs fail.",
  },
  {
    label: "GitHub CLI",
    value: "healthy",
    tone: "ok",
    detail: "Repo, CI, deploy, issue, and PR checks depend on authenticated gh access.",
  },
  {
    label: "Home Assistant MCP",
    value: "healthy",
    tone: "ok",
    detail: "Home state, chores, solar, and device checks stay behind local auth.",
  },
  {
    label: "Skill Workshop",
    value: "healthy",
    tone: "ok",
    detail: "Reusable playbooks and durable skill proposals can be inspected before approval.",
  },
  {
    label: "Host restart",
    value: "armed",
    tone: "ok",
    detail:
      "Restart handle is installed, but still requires explicit confirmation before rebooting the local host.",
  },
  {
    label: "Failure state",
    value: "blocked",
    tone: "danger",
    detail:
      "Reserved for broken auth, missing tools, unavailable services, or checks that need manual repair.",
  },
];

const statusLegend = [
  ["ok", "Green", "Working"],
  ["warning", "Yellow", "Needs attention"],
  ["danger", "Red", "Stopped"],
];

const reviewRows = [
  [
    "QA / Red Team",
    "available",
    "Read-only second pass for bugs, weak validation, privacy issues, and overclaims.",
  ],
  ["Deploy watch", "active", "GitHub deploy jobs are watched until the final status is known."],
  [
    "Public safety",
    "gated",
    "The page shows status-level facts only, not private operational contents.",
  ],
];

const identityRows = [
  ["User", "Nikolaj"],
  ["Agent", "Jason"],
  ["Soul", "engineering-minded"],
  ["Memory", "layered"],
];
---

<Layout
  title={`Personal Agent OS | ${SITE.title}`}
  description="A public-safe cockpit for Jason's personal agent operating layer."
>
  <Header />
  <main id="main-content" class="w-full pb-16">
    <section class="mx-auto w-full max-w-4xl px-4 pt-8 pb-8">
      <p class="eyebrow">Personal Agent OS</p>
      <h1 class="mt-4 max-w-3xl text-4xl font-semibold tracking-tight text-foreground sm:text-5xl">
        Agent ops cockpit.
      </h1>
      <p class="mt-5 max-w-2xl text-base leading-8 text-foreground/78">
        A public-safe collaboration-style view of the local agent layer: runtime status, orchestration flows,
        schedules, memory posture, and review gates. No prompts, chat IDs, hostnames, local addresses, secrets, or
        raw logs.
      </p>
    </section>

    <section class="mx-auto max-w-4xl px-4">
      <div class="ops-shell" aria-label="Agent OS cockpit">
        <aside class="ops-sidebar" aria-label="Agent OS tabs">
          <div class="team-title">
            <span>NF</span>
            <div>
              <strong>Jason OS</strong>
              <p>private operating layer</p>
            </div>
          </div>

          <div class="tab-list" role="tablist" aria-label="Agent OS views">
            {tabs.map(([id, name, detail]) => (
              <button
                type="button"
                class:list={["tab-button", id === "runtime" && "selected"]}
                data-tab={id}
                aria-controls={`${id}-panel`}
                aria-selected={id === "runtime" ? "true" : "false"}
                role="tab"
              >
                <strong>{name}</strong>
                <span>{detail}</span>
              </button>
            ))}
          </div>
        </aside>

        <section class="ops-main">
          <section
            id="runtime-panel"
            class="tab-panel"
            data-panel="runtime"
            role="tabpanel"
            aria-label="Runtime"
            hidden
          >
            <div class="panel-topbar">
              <div>
                <p class="eyebrow">Runtime</p>
                <h2>Operating layer health</h2>
              </div>
              <span>Snapshot 26 Jun 2026, 08:50 CPH</span>
            </div>

            <div class="metric-grid">
              {runtimeRows.map(([label, value, detail]) => (
                <article class="metric-card">
                  <span>{label}</span>
                  <strong>{value}</strong>
                  <p>{detail}</p>
                </article>
              ))}
            </div>
          </section>

          <section
            id="orchestration-panel"
            class="tab-panel"
            data-panel="orchestration"
            role="tabpanel"
            aria-label="Orchestration"
          >
            <div class="panel-topbar">
              <div>
                <p class="eyebrow">Orchestration</p>
                <h2>Flows running behind Jason</h2>
              </div>
              <span>Snapshot 26 Jun 2026, 08:50 CPH</span>
            </div>

            <div class="flow-feed">
              {orchestrationFlows.map((flow) => (
                <article class="flow-card">
                  <div class="flow-head">
                    <div>
                      <h3>{flow.name}</h3>
                      <p>{flow.owner}</p>
                    </div>
                    <span>{flow.state}</span>
                  </div>

                  <div class="flow-path" aria-label={`${flow.name} path`}>
                    {flow.path.map((step) => (
                      <span>{step}</span>
                    ))}
                  </div>

                  <p>{flow.detail}</p>
                </article>
              ))}
            </div>
          </section>

          <section
            id="schedules-panel"
            class="tab-panel"
            data-panel="schedules"
            role="tabpanel"
            aria-label="Schedules"
            hidden
          >
            <div class="panel-topbar">
              <div>
                <p class="eyebrow">Schedules</p>
                <h2>Cron-backed work</h2>
              </div>
              <span>12 tracked jobs</span>
            </div>

            <div class="row-list">
              {scheduleRows.map(([label, value, detail]) => (
                <article>
                  <h3>{label}</h3>
                  <strong>{value}</strong>
                  <p>{detail}</p>
                </article>
              ))}
            </div>
          </section>

          <section
            id="skills-panel"
            class="tab-panel"
            data-panel="skills"
            role="tabpanel"
            aria-label="Skills"
            hidden
          >
            <div class="panel-topbar">
              <div>
                <p class="eyebrow">Skills</p>
                <h2>Enabled skill health</h2>
              </div>
              <span>green / yellow / red</span>
            </div>

            <div class="skill-health">
              <div class="status-legend" aria-label="Skill health color legend">
                {statusLegend.map(([tone, label, detail]) => (
                  <div class:list={["legend-item", `status-${tone}`]}>
                    <span aria-hidden="true"></span>
                    <strong>{label}</strong>
                    <p>{detail}</p>
                  </div>
                ))}
              </div>

              <div class="health-grid">
                {skillRows.map((row) => (
                  <article class:list={["health-card", `status-${row.tone}`]}>
                    <div>
                      <span>{row.label}</span>
                      <strong>{row.value}</strong>
                    </div>
                    <p>{row.detail}</p>
                  </article>
                ))}
              </div>
            </div>
          </section>

          <section
            id="memory-panel"
            class="tab-panel"
            data-panel="memory"
            role="tabpanel"
            aria-label="Memory"
            hidden
          >
            <div class="panel-topbar">
              <div>
                <p class="eyebrow">Memory</p>
                <h2>Recall without raw dumps</h2>
              </div>
              <span>public-safe summary</span>
            </div>

            <div class="row-list">
              {memoryRows.map(([label, value, detail]) => (
                <article>
                  <h3>{label}</h3>
                  <strong>{value}</strong>
                  <p>{detail}</p>
                </article>
              ))}
            </div>
          </section>

          <section
            id="review-panel"
            class="tab-panel"
            data-panel="review"
            role="tabpanel"
            aria-label="Review"
            hidden
          >
            <div class="panel-topbar">
              <div>
                <p class="eyebrow">Review</p>
                <h2>Gates before public claims</h2>
              </div>
              <span>privacy first</span>
            </div>

            <div class="row-list">
              {reviewRows.map(([label, value, detail]) => (
                <article>
                  <h3>{label}</h3>
                  <strong>{value}</strong>
                  <p>{detail}</p>
                </article>
              ))}
            </div>
          </section>

          <div class="identity-strip" aria-label="Identity and memory">
            {identityRows.map(([label, value]) => (
              <div>
                <span>{label}</span>
                <strong>{value}</strong>
              </div>
            ))}
          </div>
        </section>
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<script>
  const tabButtons = document.querySelectorAll("[data-tab]");
  const tabPanels = document.querySelectorAll("[data-panel]");

  tabButtons.forEach((button) => {
    button.addEventListener("click", () => {
      const selectedTab = button.getAttribute("data-tab");

      tabButtons.forEach((candidate) => {
        const isSelected = candidate === button;
        candidate.classList.toggle("selected", isSelected);
        candidate.setAttribute("aria-selected", isSelected ? "true" : "false");
      });

      tabPanels.forEach((panel) => {
        panel.toggleAttribute("hidden", panel.getAttribute("data-panel") !== selectedTab);
      });
    });
  });
</script>

<style>
  .eyebrow {
    color: var(--accent);
    font-size: 0.75rem;
    font-weight: 850;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .ops-shell {
    display: grid;
    height: 46rem;
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: color-mix(in srgb, var(--background) 92%, var(--muted) 8%);
    color: var(--foreground);
    grid-template-columns: 15rem minmax(0, 1fr);
  }

  .ops-sidebar {
    grid-column: 1;
    border-right: 1px solid var(--border);
    background: color-mix(in srgb, var(--foreground) 90%, var(--background) 10%);
    padding: 1rem;
    overflow: auto;
  }

  .team-title {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    border-bottom: 1px solid color-mix(in srgb, var(--background) 18%, transparent);
    padding-bottom: 1rem;
    color: var(--background);
  }

  .team-title > span {
    display: grid;
    width: 2.4rem;
    height: 2.4rem;
    place-items: center;
    border-radius: 7px;
    background: var(--background);
    color: var(--foreground);
    font-weight: 850;
  }

  .team-title strong {
    display: block;
    font-size: 1rem;
    line-height: 1.25;
  }

  .team-title p,
  .tab-button span,
  .panel-topbar > span,
  .flow-head p,
  .flow-card > p,
  .metric-card p,
  .row-list p {
    margin: 0;
    color: color-mix(in srgb, var(--foreground) 68%, transparent);
    font-size: 0.88rem;
    line-height: 1.55;
  }

  .tab-list {
    display: grid;
    gap: 0.35rem;
    margin-top: 1rem;
  }

  .tab-button {
    width: 100%;
    border: 1px solid color-mix(in srgb, var(--background) 10%, transparent);
    border-radius: 6px;
    background: transparent;
    padding: 0.75rem;
    color: color-mix(in srgb, var(--background) 88%, transparent);
    text-align: left;
    cursor: pointer;
  }

  .tab-button:hover,
  .tab-button.selected {
    border-color: color-mix(in srgb, var(--background) 24%, transparent);
    background: var(--background);
    color: var(--foreground);
  }

  .tab-button strong,
  .tab-button span {
    display: block;
  }

  .tab-button strong {
    font-size: 0.94rem;
  }

  .tab-button span {
    margin-top: 0.15rem;
    font-size: 0.78rem;
  }

  .ops-sidebar .team-title p,
  .ops-sidebar .tab-button span {
    color: color-mix(in srgb, var(--background) 68%, transparent);
  }

  .ops-sidebar .tab-button.selected span,
  .ops-sidebar .tab-button:hover span {
    color: color-mix(in srgb, var(--foreground) 68%, transparent);
  }

  .ops-main {
    grid-column: 2;
    display: grid;
    overflow: hidden;
    min-width: 0;
    background: var(--background);
    grid-template-rows: minmax(0, 1fr) auto;
  }

  .tab-panel[hidden] {
    display: none;
  }

  .tab-panel {
    min-height: 0;
    overflow: auto;
  }

  .panel-topbar {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 1rem;
    border-bottom: 1px solid var(--border);
    padding: 1.25rem 1.5rem;
  }

  .panel-topbar h2 {
    margin: 0.35rem 0 0;
    color: var(--foreground);
    font-size: 1.85rem;
    font-weight: 760;
    letter-spacing: 0;
    line-height: 1.2;
  }

  .panel-topbar > span {
    text-align: right;
  }

  .metric-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.85rem;
    padding: 1rem;
  }

  .metric-card,
  .flow-card,
  .row-list article {
    border: 1px solid var(--border);
    border-radius: 8px;
    background: var(--background);
  }

  .metric-card {
    min-height: 9rem;
    padding: 1rem;
  }

  .metric-card span,
  .identity-strip span {
    display: block;
    color: color-mix(in srgb, var(--foreground) 62%, transparent);
    font-size: 0.68rem;
    font-weight: 850;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .metric-card strong,
  .row-list strong,
  .identity-strip strong {
    display: block;
    margin-top: 0.35rem;
    color: var(--accent);
    font-size: 0.95rem;
    line-height: 1.3;
  }

  .metric-card p {
    margin-top: 0.7rem;
  }

  .flow-feed,
  .row-list,
  .skill-health {
    display: grid;
    gap: 0.85rem;
    padding: 1rem;
  }

  .flow-card,
  .row-list article {
    padding: 1rem;
  }

  .flow-head {
    display: flex;
    align-items: start;
    justify-content: space-between;
    gap: 1rem;
  }

  .flow-head h3,
  .row-list h3 {
    margin: 0;
    color: var(--foreground);
    font-size: 1.06rem;
    font-weight: 780;
    line-height: 1.3;
  }

  .flow-head > span {
    border: 1px solid color-mix(in srgb, var(--accent) 34%, var(--border));
    border-radius: 999px;
    padding: 0.2rem 0.55rem;
    color: var(--accent);
    font-size: 0.7rem;
    font-weight: 850;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .flow-path {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin: 0.9rem 0;
  }

  .flow-path span {
    border: 1px solid var(--border);
    border-radius: 999px;
    background: color-mix(in srgb, var(--background) 84%, var(--muted) 16%);
    padding: 0.25rem 0.65rem;
    color: var(--foreground);
    font-size: 0.78rem;
    font-weight: 760;
  }

  .row-list article {
    display: grid;
    grid-template-columns: minmax(8rem, 0.6fr) minmax(6rem, 0.3fr) minmax(0, 1fr);
    gap: 1rem;
    align-items: baseline;
  }

  .row-list strong {
    margin-top: 0;
    text-transform: uppercase;
  }

  .status-legend {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.65rem;
  }

  .legend-item,
  .health-card {
    border: 1px solid var(--border);
    border-radius: 8px;
    background: var(--background);
  }

  .legend-item {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 0.15rem 0.55rem;
    align-items: center;
    padding: 0.75rem;
  }

  .legend-item > span {
    width: 0.7rem;
    height: 0.7rem;
    border-radius: 999px;
    background: var(--status-color);
    box-shadow: 0 0 0 0.2rem color-mix(in srgb, var(--status-color) 16%, transparent);
  }

  .legend-item strong {
    color: var(--foreground);
    font-size: 0.8rem;
    font-weight: 850;
    line-height: 1.2;
    text-transform: uppercase;
  }

  .legend-item p {
    grid-column: 2;
    margin: 0;
    color: color-mix(in srgb, var(--foreground) 62%, transparent);
    font-size: 0.78rem;
    line-height: 1.35;
  }

  .health-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem;
  }

  .health-card {
    position: relative;
    display: grid;
    gap: 0.85rem;
    min-height: 8.4rem;
    overflow: hidden;
    padding: 1rem;
  }

  .health-card::before {
    position: absolute;
    inset: 0 auto 0 0;
    width: 0.35rem;
    background: var(--status-color);
    content: "";
  }

  .health-card div {
    display: flex;
    align-items: start;
    justify-content: space-between;
    gap: 0.75rem;
  }

  .health-card span {
    color: color-mix(in srgb, var(--foreground) 68%, transparent);
    font-size: 0.72rem;
    font-weight: 850;
    letter-spacing: 0.08em;
    line-height: 1.25;
    text-transform: uppercase;
  }

  .health-card strong {
    border: 1px solid color-mix(in srgb, var(--status-color) 40%, var(--border));
    border-radius: 999px;
    background: color-mix(in srgb, var(--status-color) 12%, var(--background));
    color: var(--status-color);
    padding: 0.2rem 0.55rem;
    font-size: 0.68rem;
    font-weight: 850;
    letter-spacing: 0.05em;
    line-height: 1.2;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .health-card p {
    margin: 0;
    color: color-mix(in srgb, var(--foreground) 70%, transparent);
    font-size: 0.88rem;
    line-height: 1.55;
  }

  .status-ok {
    --status-color: #17803d;
  }

  .status-warning {
    --status-color: #9a6a00;
  }

  .status-danger {
    --status-color: #b42318;
  }

  .identity-strip {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    border-top: 1px solid var(--border);
  }

  .identity-strip div {
    border-left: 1px solid var(--border);
    padding: 0.9rem 1rem;
  }

  .identity-strip div:first-child {
    border-left: 0;
  }

  @media (max-width: 980px) {
    .ops-shell {
      grid-template-columns: 13rem minmax(0, 1fr);
    }

    .metric-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 760px) {
    .ops-shell {
      display: block;
      height: auto;
      min-height: auto;
    }

    .ops-sidebar {
      border-right: 0;
      border-bottom: 1px solid var(--border);
      padding: 0.75rem;
    }

    .team-title {
      padding-bottom: 0.75rem;
    }

    .tab-list {
      display: flex;
      gap: 0.55rem;
      overflow-x: auto;
      padding-bottom: 0.25rem;
    }

    .tab-button {
      min-width: 11rem;
    }

    .panel-topbar {
      display: block;
      padding: 1rem;
    }

    .panel-topbar > span {
      display: block;
      margin-top: 0.75rem;
      text-align: left;
    }

    .metric-grid,
    .status-legend,
    .health-grid,
    .identity-strip {
      grid-template-columns: 1fr;
    }

    .identity-strip div {
      border-top: 1px solid var(--border);
      border-left: 0;
    }

    .identity-strip div:first-child {
      border-top: 0;
    }

    .flow-head,
    .row-list article {
      display: block;
    }

    .flow-head > span {
      display: inline-flex;
      margin-top: 0.75rem;
    }

    .row-list strong {
      margin-top: 0.45rem;
    }

    .row-list p {
      margin-top: 0.55rem;
    }
  }
</style>
