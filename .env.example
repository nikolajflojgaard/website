#
# Public env vars (safe to expose to the client bundle)
#

# Optional Google Search Console verification.
PUBLIC_GOOGLE_SITE_VERIFICATION=

# Optional public Supabase config for the header auth icon.
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=

# Optional email guard for signed-in header state.
PUBLIC_AGENT_OS_ALLOWED_EMAIL=
